<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          xmlns:tools="http://schemas.android.com/tools">
  <application android:allowBackup="false"
               android:icon="@mipmap/appicon"
               android:roundIcon="@mipmap/appicon_round"
               android:supportsRtl="true"
               android:label="EleFi">
    <!--
      ML Kit reads receipts on the device (ADR-0018), but its SDK can also send anonymous
      usage metrics to Google through this transport. Removing it means nothing leaves the
      phone: no image, no text, and no metrics either. The one automatic egress stays the
      encrypted Drive backup.
    -->
    <service android:name="com.google.android.datatransport.runtime.backends.TransportBackendDiscovery"
             tools:node="remove" />
    <service android:name="com.google.android.datatransport.runtime.scheduling.jobscheduling.JobInfoSchedulerService"
             tools:node="remove" />
    <receiver android:name="com.google.android.datatransport.runtime.scheduling.jobscheduling.AlarmManagerSchedulerBroadcastReceiver"
              tools:node="remove" />
  </application>

  <!--
    allowBackup is false on purpose. Android's automatic cloud backup would copy the app's
    data directory, including the encrypted database, to Google's servers outside the one
    egress path this app allows (NFR-5.1). Backup happens through EleFi's own encrypted
    Drive path or not at all.
  -->

  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
  <uses-permission android:name="android.permission.INTERNET" />

  <!--
    SMS-assisted capture (ADR-0010, roadmap S38). Declared, but never requested until the
    user turns the feature on in Settings, and refusing it costs nothing but suggestions
    (SM10). The receiver is gated by BROADCAST_SMS so only the system can deliver to it.

    Notification access for Payment Apps (ADR-0014) needs no line here: it is granted by the
    user in system settings and bound through the service's BIND_NOTIFICATION_LISTENER_SERVICE.

    POST_NOTIFICATIONS is for Alert Prompts and plan reminders on Android 13 and later.
  -->
  <uses-permission android:name="android.permission.RECEIVE_SMS" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

  <!--
    Plan reminders are alarms, and a restart clears every alarm. This lets EleFi put them back
    after the phone starts; it does nothing else at boot.
  -->
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

  <!--
    Taking a photo of a receipt (ADR-0018). Asked for only when the user taps Take a photo;
    choosing one from the gallery needs no permission. Not required, so a phone without a
    camera can still install EleFi.
  -->
  <uses-permission android:name="android.permission.CAMERA" />
  <uses-feature android:name="android.hardware.camera" android:required="false" />

  <queries>
    <!--
      Without this, Browser.OpenAsync with BrowserLaunchMode.External fails silently on
      Android 11 and later, and the support link simply appears not to work (FR-12.4).
    -->
    <intent>
      <action android:name="android.intent.action.VIEW" />
      <data android:scheme="https" />
    </intent>
    <!-- The camera app, for Take a photo of a receipt. -->
    <intent>
      <action android:name="android.media.action.IMAGE_CAPTURE" />
    </intent>
  </queries>
</manifest>
