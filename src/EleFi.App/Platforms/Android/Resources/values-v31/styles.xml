<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12 and later draw their own splash from these, with Ele floating as the icon. -->
    <style name="EleFi.SplashTheme" parent="Maui.SplashTheme">
        <item name="android:windowBackground">@drawable/boot_window</item>
        <item name="android:windowSplashScreenBackground">@color/colorPrimary</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/boot_ele_floating</item>
        <item name="android:windowSplashScreenAnimationDuration">1000</item>
    </style>
</resources>
