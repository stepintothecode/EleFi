<?xml version="1.0" encoding="utf-8"?>
<!-- Ele's float on the start-up screen: up 12dp and a slight rock, 2.6s round trip, from the
     system splash through to the first render of the app. -->
<set xmlns:android="http://schemas.android.com/apk/res/android" android:ordering="together">
    <objectAnimator
        android:propertyName="translateY"
        android:valueFrom="0"
        android:valueTo="-9"
        android:duration="1300"
        android:repeatCount="infinite"
        android:repeatMode="reverse"
        android:interpolator="@android:interpolator/accelerate_decelerate" />
    <objectAnimator
        android:propertyName="rotation"
        android:valueFrom="-2"
        android:valueTo="2"
        android:duration="1300"
        android:repeatCount="infinite"
        android:repeatMode="reverse"
        android:interpolator="@android:interpolator/accelerate_decelerate" />
</set>
