<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>$(EleFiTargetFramework)</TargetFramework>
    <RootNamespace>EleFi.Ui</RootNamespace>
    <AssemblyName>EleFi.Ui</AssemblyName>
    <Description>Razor components and view models. Platform-free, so bUnit can test them without a device.</Description>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../EleFi.Application/EleFi.Application.csproj" />
    <ProjectReference Include="../EleFi.Domain/EleFi.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

</Project>
