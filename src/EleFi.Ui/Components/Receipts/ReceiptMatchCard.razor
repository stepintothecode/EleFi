@using System.Globalization
@using EleFi.Application.Receipts
@using EleFi.Domain.Money
@using EleFi.Domain.Receipts
@using EleFi.Domain.Transactions

@*
    The transaction a receipt will be attached to, tagged with anything they disagree on; Ele says the details.
*@

<div class="receipt-match">
    <div class="receipt-match-row">
        <div class="grow">
            <div class="who">@(ReceiptCheck.Counterparty(Transaction) ?? "Transfer")</div>
            <div class="meta">@Transaction.Kind.DisplayName() &middot; @When</div>
        </div>
        <div class="amount">@MoneyText.ToDisplayString(Transaction.SourceAmount)</div>
    </div>

    @* The details are Ele's to say, beside the card; the card only tags it. *@
    @if (Discrepancy != Discrepancy.None)
    {
        <span class="pill warn receipt-match-tag">@DiscrepancyText.Tag(Discrepancy)</span>
    }
</div>

@code {
    /// <summary>The transaction.</summary>
    [Parameter, EditorRequired]
    public Transaction Transaction { get; set; } = null!;

    /// <summary>What the receipt says.</summary>
    [Parameter, EditorRequired]
    public ReceiptFacts Facts { get; set; } = null!;

    /// <summary>What they disagree on.</summary>
    [Parameter]
    public Discrepancy Discrepancy { get; set; }

    private string When => Transaction.OccurredOn.ToString("d MMM", CultureInfo.InvariantCulture)
        + (Transaction.OccurredAtTime is { } at ? " " + at.ToString("HH\\:mm", CultureInfo.InvariantCulture) : string.Empty);
}
