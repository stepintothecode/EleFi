@page "/transactions/{Id:guid}"
@using EleFi.Application.Abstractions
@using EleFi.Application.Labels
@using EleFi.Application.Transactions
@using EleFi.Application.Typeahead
@using EleFi.Domain.Audit
@using EleFi.Domain.Containers
@using EleFi.Domain.Labels
@using EleFi.Domain.Money
@using EleFi.Domain.Parties
@using EleFi.Domain.Transactions
@using EleFi.Ui.Services
@inject EditTransactionService Editing
@inject ITransactionRepository Transactions
@inject EleFi.Application.Goals.GoalService Goals
@inject IContainerRepository Containers
@inject LabelService LabelList
@inject IPartyRepository Parties
@inject IAppRepository Apps
@inject IClock Clock
@inject UndoHistory Undo
@inject EleReactions Ele
@inject NavigationManager Nav
@inject FormSuggestions Suggest
@implements IDisposable

@*
    Edit one transaction, and see everything that has ever happened to it.

    The review flag only means something if it can be acted on: a quick capture guesses, and
    this is where the guess gets corrected or confirmed. Without this screen the flag was
    just a permanent mark on a row nobody could fix.

    Delete lives at the bottom, in red, behind a confirmation. It is a soft delete: the row
    leaves every balance and export immediately, and stays restorable.
*@

<PageTitle>Edit transaction</PageTitle>

@if (_loading)
{
    <div class="card"><div class="skeleton" style="width:70%;"></div></div>
}
else if (_transaction is null)
{
    <h1>Not found</h1>
    <p class="muted">That transaction is gone.</p>
    <a class="btn btn-ghost btn-block" href="transactions">Back to the list</a>
}
else
{
    <div class="section-head">
        <h1>Edit</h1>
        <span class="row" style="gap:4px;">
            <UndoRedo Area="@UndoHistory.Transactions" OnChanged="ReloadAfterUndoAsync" />
            <button type="button" class="btn-ghost" @onclick="Close">Close</button>
        </span>
    </div>

    @* One button and an "i". The explanation used to fill the top of the screen on every
       flagged transaction, which is most of the ones anyone opens from a message. *@
    @if (_transaction.NeedsReview)
    {
        <div class="review-bar">
            <div class="field-head">
                <span class="review-flag">Needs review</span>
                <InfoButton Topic="Needs review">
                    <p>
                        This was recorded from a bank SMS or a payment app, or captured quickly, so
                        some details may have been guessed: usually the container, or who was paid.
                    </p>
                    <p class="muted small">
                        It already counts in every balance. Correct anything below and save, or tap
                        "Looks right" to confirm it as it stands. Either clears the flag.
                    </p>
                </InfoButton>
            </div>
            <button class="primary btn-block" @onclick="MarkReviewedAsync">Looks right, clear the flag</button>
        </div>
    }

    <div class="card">
        <div class="field">
            <label for="amount">Amount</label>
            <input id="amount" class="amount-input" type="text" inputmode="decimal"
                   @bind="_amountText" autocomplete="off" />
        </div>

        <div class="chips" style="margin-bottom:14px;" role="group" aria-label="Kind">
            @foreach (var kind in new[] { TransactionKind.Debit, TransactionKind.Credit, TransactionKind.SelfTransfer })
            {
                <button type="button" class="chip @(_kind == kind ? "on" : string.Empty)"
                        @onclick="() => SetKind(kind)">@kind.DisplayName()</button>
            }
        </div>

        @if (_kind == TransactionKind.SelfTransfer)
        {
            <div class="field">
                <label for="from">Source container</label>
                <ContainerSelect Id="from" Title="Source container" Containers="_containers" @bind-Value="_containerId" />
            </div>
            <div class="field">
                <label for="to">Destination container</label>
                <ContainerSelect Id="to" Title="Destination container" Containers="_containers" @bind-Value="_destinationContainerId" />
            </div>
        }
        else
        {
            <div class="field">
                <label for="container">@(_kind == TransactionKind.Debit ? "Paid from" : "Received into")</label>
                <ContainerSelect Id="container" Title="@(_kind == TransactionKind.Debit ? "Paid from" : "Received into")" Containers="_containers" @bind-Value="_containerId" />
            </div>

            <div class="field">
                <div class="field-head">
                    <label for="party">@(_kind == TransactionKind.Debit ? "Paid to" : "Received from")</label>
                    @if (SavedContactId is { } contactId)
                    {
                        <a class="small contact-link" href="contacts/@contactId">Contact</a>
                    }
                </div>
                <TypeaheadInput Id="party" Value="@_partyName" ValueChanged="PartyChangedAsync" Candidates="_partyCandidates" />
            </div>

            <div class="field">
                <label>Labels <span class="muted small">(optional, pick any)</span></label>
                <LabelPicker Labels="_labels" Selected="_labelIds" SelectedChanged="ids => _labelIds = ids" />
            </div>
        }

        <div class="row">
            <div class="field grow">
                <label for="date">Date</label>
                <input id="date" type="date" max="@Clock.Today.ToString("yyyy-MM-dd")" @bind="_date" />
            </div>
            <div class="field grow">
                <label for="time">Time</label>
                <input id="time" type="time" @bind="_time" />
            </div>
        </div>

        <div class="field">
            <div class="field-head">
                <label for="marketplace">Bought through <span class="muted small">(optional)</span></label>
                <AppRoleInfo />
            </div>
            <TypeaheadInput Id="marketplace" @bind-Value="_marketplaceAppName" Candidates="_boughtCandidates"
                            IdleCount="3" PanelLabel="Apps" />
        </div>

        <div class="field">
            <div class="field-head">
                <label for="payment">Paid with <span class="muted small">(optional)</span></label>
                <AppRoleInfo Payment="true" />
            </div>
            <TypeaheadInput Id="payment" @bind-Value="_paymentAppName" Candidates="_paidCandidates"
                            IdleCount="3" PanelLabel="Apps" />
        </div>

        <div class="field">
            <label for="note">Note <span class="muted small">(optional)</span></label>
            <TypeaheadInput Id="note" Value="@(_description ?? string.Empty)" ValueChanged="v => _description = v"
                            Candidates="_noteCandidates" IdleCount="3" OffersNew="false" Capitalize="sentences"
                            EnterKeyHint="done" PanelLabel="Notes used before" />
        </div>

        @if (_goals.Count > 0)
        {
            <div class="field">
                <label for="goal">Counts toward <span class="muted small">(optional)</span></label>
                <select id="goal" @bind="_goalId">
                    <option value="">No goal</option>
                    @foreach (var goal in _goals)
                    {
                        <option value="@goal.Id">@goal.Name</option>
                    }
                </select>
            </div>
        }

        <button class="primary btn-block" disabled="@_busy" @onclick="SaveAsync">Save changes</button>
    </div>

    <h2>History</h2>
    <div class="card">
        @if (_timeline.Count == 0)
        {
            <p class="muted small" style="margin:0;">Nothing recorded yet.</p>
        }
        else
        {
            @foreach (var entry in _timeline)
            {
                <div class="timeline-entry">
                    <div class="row between">
                        <strong>@ActionLabel(entry.Action)</strong>
                        <span class="meta">@entry.OccurredAt.ToLocalTime().ToString("d MMM yyyy, HH:mm")</span>
                    </div>

                    @if (entry.Changes.Count > 0)
                    {
                        <ul class="timeline-changes">
                            @foreach (var change in entry.Changes)
                            {
                                <li>
                                    <span class="meta">@change.Field</span>
                                    <span class="was">@change.From</span>
                                    <span aria-hidden="true">&rarr;</span>
                                    <span class="now">@change.To</span>
                                </li>
                            }
                        </ul>
                    }
                    else if (entry.Via is { } via)
                    {
                        <div class="meta">via @via</div>
                    }
                </div>
            }
        }
    </div>

    <h2>Danger</h2>
    <div class="card">
        <p class="small muted">
            Deleting removes this from every balance, report, and export immediately. It stays
            recoverable, and the deletion is recorded above.
        </p>

        @if (!_deleteArmed)
        {
            <button class="btn-ghost btn-block danger" @onclick="() => _deleteArmed = true">Delete this transaction</button>
        }
        else
        {
            <div class="row">
                <button class="btn-ghost grow" @onclick="() => _deleteArmed = false">Keep it</button>
                <button class="primary danger grow" @onclick="DeleteAsync">Delete</button>
            </div>
        }
    </div>
}

@code {
    /// <summary>The transaction being edited.</summary>
    [Parameter]
    public Guid Id { get; set; }

    /// <summary>The app's back handling, cascaded from the router.</summary>
    [CascadingParameter]
    public BackNavigator? Back { get; set; }

    private Transaction? _transaction;
    private IReadOnlyList<Container> _containers = [];
    private IReadOnlyList<Label> _labels = [];
    private IReadOnlyList<TypeaheadCandidate> _partyCandidates = [];
    private IReadOnlyList<TypeaheadCandidate> _boughtCandidates = [];
    private IReadOnlyList<TypeaheadCandidate> _paidCandidates = [];
    private SuggestionPools? _pools;
    private IReadOnlyList<HistoryEntry> _timeline = [];

    private TransactionKind _kind = TransactionKind.Debit;
    private string _amountText = string.Empty;
    private Guid _containerId;
    private Guid _destinationContainerId;
    private IReadOnlyList<Guid> _labelIds = [];
    private string _partyName = string.Empty;
    private string _paymentAppName = string.Empty;
    private string _marketplaceAppName = string.Empty;
    private string? _description;
    private DateTime _date = DateTime.Today;
    private TimeOnly? _time;

    private bool _loading = true;
    private bool _busy;
    private bool _deleteArmed;
    private bool _disposed;

    private Currency Currency => _transaction?.SourceCurrency ?? Currency.Inr;

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;

        _transaction = await Editing.FindAsync(Id);
        _containers = ContainerGrouping.InPickerOrder(await Containers.ListSelectableAsync());
        _labels = await LabelList.ListByUsageAsync();
        _partyCandidates = TypeaheadCandidates.From(await Parties.ListExternalAsync());
        _pools = await Suggest.LoadAsync();

        if (_transaction is not null)
        {
            _timeline = await Editing.HistoryAsync(Id);
            Populate(_transaction);
            await LoadNoteCandidatesAsync();

            // Goals that take contributions, plus the one it already counts toward, so an
            // archived goal still shows rather than silently reading "No goal".
            var attributable = await Goals.AttributableAsync();
            _goals = _transaction.GoalId is { } current && attributable.All(g => g.Id != current)
                && await Goals.FindAsync(current) is { } existing
                ? [.. attributable, existing]
                : attributable;
            _goalId = _transaction.GoalId;
        }

        _loading = false;
    }

    private void Populate(Transaction t)
    {
        _kind = t.Kind;
        _amountText = MoneyText.ToBareDecimal(t.SourceAmount);
        _date = t.OccurredOn.ToDateTime(TimeOnly.MinValue);
        _time = t.OccurredAtTime;
        _description = t.Description;
        _labelIds = [.. t.Labels.Select(l => l.LabelId)];
        _marketplaceAppName = t.MarketplaceApp?.Name ?? string.Empty;
        _paymentAppName = t.PaymentApp?.Name ?? string.Empty;

        // The form thinks in "my container" plus "the other end", while the record holds two
        // parties. Which is which depends on the kind.
        switch (_kind)
        {
            case TransactionKind.Debit:
                _containerId = t.SourceParty?.ContainerId ?? Guid.Empty;
                _partyName = t.DestinationParty?.Name ?? string.Empty;
                break;

            case TransactionKind.Credit:
                _containerId = t.DestinationParty?.ContainerId ?? Guid.Empty;
                _partyName = t.SourceParty?.Name ?? string.Empty;
                break;

            default:
                _containerId = t.SourceParty?.ContainerId ?? Guid.Empty;
                _destinationContainerId = t.DestinationParty?.ContainerId ?? Guid.Empty;
                break;
        }
    }

    // Labels no longer restrict which kind they suit, so switching kind leaves them alone.
    private void SetKind(TransactionKind kind) => _kind = kind;

    // Back to wherever the editor was opened from: the list, the dashboard, or quick capture
    // after "Add other details". Straight to the list when there is nothing behind it.
    private void Close() => Leave("transactions");

    // The editor is done with, so back must not return to it.
    private void Leave(string fallback)
    {
        if (Back is not null)
        {
            Back.Leave(fallback);
            return;
        }

        Nav.NavigateTo(fallback);
    }

    private async Task SaveAsync()
    {
        if (!MoneyText.TryParse(_amountText, Currency, out var amount) || amount.Minor <= 0)
        {
            Ele.Problem("Enter an amount greater than zero.");
            return;
        }

        _busy = true;
        try
        {
            var containerParty = await Containers.PartyForAsync(_containerId);
            if (containerParty is null)
            {
                Ele.Problem("That container no longer exists. Pick another one.");
                return;
            }

            Guid sourceId;
            Guid destinationId;

            if (_kind == TransactionKind.SelfTransfer)
            {
                var destinationParty = await Containers.PartyForAsync(_destinationContainerId);
                if (destinationParty is null)
                {
                    Ele.Problem("That destination container no longer exists. Pick another one.");
                    return;
                }

                (sourceId, destinationId) = (containerParty.Id, destinationParty.Id);
            }
            else
            {
                if (string.IsNullOrWhiteSpace(_partyName))
                {
                    Ele.Problem(_kind == TransactionKind.Debit ? "Who was it paid to?" : "Who was it received from?");
                    return;
                }

                var external = await Parties.GetOrCreateExternalAsync(_partyName);

                (sourceId, destinationId) = _kind == TransactionKind.Debit
                    ? (containerParty.Id, external.Id)
                    : (external.Id, containerParty.Id);
            }

            Guid? marketplaceAppId = string.IsNullOrWhiteSpace(_marketplaceAppName)
                ? null
                : (await Apps.GetOrCreateAsync(_marketplaceAppName)).Id;

            Guid? paymentAppId = string.IsNullOrWhiteSpace(_paymentAppName)
                ? null
                : (await Apps.GetOrCreateAsync(_paymentAppName)).Id;

            // Taken before saving, so undo can put every field back through the same path.
            var before = EditRequest.Snapshot(_transaction!);
            var goalBefore = _transaction!.GoalId;
            var goalAfter = _goalId;

            var after = new EditRequest(
                Id,
                sourceId,
                destinationId,
                amount.Minor,
                DateOnly.FromDateTime(_date),
                _time,
                _labelIds,
                _description,
                marketplaceAppId,
                paymentAppId,
                // Editing a flagged transaction is the review. Leaving the flag set after
                // someone has been through every field would make it meaningless.
                NeedsReview: false);

            var result = await Editing.EditAsync(after);
            if (!result.Succeeded)
            {
                Ele.Problem(result.Error!);
                return;
            }

            if (goalAfter != goalBefore && await Goals.AttributeAsync(Id, goalAfter) is { } problem)
            {
                Ele.Problem(problem);
                return;
            }

            var id = Id;
            Undo.Push(
                UndoHistory.Transactions,
                $"edit to {Counterparty ?? "the transfer"}",
                async () => await ApplyAsync(before, id, goalBefore),
                async () => await ApplyAsync(after, id, goalAfter));

            // "Updated", never "Saved": the transaction changed, no money was put aside.
            Ele.React(EleMoment.Updated, MoneyText.ToDisplayString(amount), Counterparty);
            await LoadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task MarkReviewedAsync()
    {
        var before = EditRequest.Snapshot(_transaction!);
        var goal = _transaction!.GoalId;
        var result = await Editing.MarkReviewedAsync(Id);

        if (!result.Succeeded)
        {
            Ele.Problem(result.Error!);
            return;
        }

        var id = Id;
        Undo.Push(
            UndoHistory.Transactions,
            $"confirming {Counterparty ?? "the transfer"}",
            async () => await ApplyAsync(before, id, goal),
            async () => Checked(await Editing.MarkReviewedAsync(id)));

        Ele.React(EleMoment.Reviewed, MoneyText.ToDisplayString(_transaction!.SourceAmount), Counterparty);
        await LoadAsync();
    }

    private async Task DeleteAsync()
    {
        var id = Id;
        var amount = _transaction is null ? null : MoneyText.ToDisplayString(_transaction.SourceAmount);
        var about = Counterparty;
        await Editing.DeleteAsync(id);

        // Straight back exactly as it was on undo: not flagged, because nothing about it changed.
        Undo.Push(
            UndoHistory.Transactions,
            $"delete of {about ?? "the transfer"}",
            () => Editing.RestoreAsync(id, flagForReview: false),
            () => Editing.DeleteAsync(id));

        Ele.React(EleMoment.Deleted, amount, about);

        // Deleted: back must never come back to a transaction that is gone.
        Leave("transactions");
    }

    // Puts a transaction to a state through the same checked path as any edit, so an undo is
    // in its history too.
    private async Task ApplyAsync(EditRequest request, Guid id, Guid? goal)
    {
        Checked(await Editing.EditAsync(request));
        if (await Goals.AttributeAsync(id, goal) is { } problem)
        {
            throw new InvalidOperationException(problem);
        }
    }

    private static void Checked(CaptureResult result)
    {
        if (!result.Succeeded)
        {
            throw new InvalidOperationException(result.Error);
        }
    }

    // After an undo or redo from the arrows, show what the transaction is now.
    private async Task ReloadAfterUndoAsync()
    {
        if (!_disposed)
        {
            await LoadAsync();
        }
    }
    public void Dispose() => _disposed = true;

    // The contact the saved transaction is with, for the link beside "Paid to".
    private Guid? SavedContactId => _transaction switch
    {
        { SourceParty.Kind: PartyKind.External } t => t.SourcePartyId,
        { DestinationParty.Kind: PartyKind.External } t => t.DestinationPartyId,
        _ => null,
    };

    // Who the transaction was with, for Ele to mention. A transfer is between the user's own
    // containers, so there is nobody else to name.
    private string? Counterparty => _kind == TransactionKind.SelfTransfer || string.IsNullOrWhiteSpace(_partyName)
        ? null
        : _partyName.Trim();

    private static string ActionLabel(AuditAction action) => action switch
    {
        AuditAction.Created => "Recorded",
        AuditAction.Updated => "Edited",
        AuditAction.Deleted => "Deleted",
        AuditAction.Restored => "Restored",
        _ => action.ToString(),
    };

    private IReadOnlyList<TypeaheadCandidate> _noteCandidates = [];

    // Note, Bought through and Paid with offer what was used with this contact before ("Gift"
    // for Mom), then what is used most overall. A half-typed or new name is not looked up: it
    // gets the most used straight away.
    private async Task PartyChangedAsync(string name)
    {
        _partyName = name;
        await LoadNoteCandidatesAsync();
    }

    private async Task LoadNoteCandidatesAsync()
    {
        if (_pools is null)
        {
            return;
        }

        var name = _kind == TransactionKind.SelfTransfer ? null : _partyName.Trim();
        var known = name is { Length: > 0 } && _partyCandidates.Any(c => string.Equals(c.Name, name, StringComparison.OrdinalIgnoreCase));
        var lists = await Suggest.ForAsync(_pools, name, known);
        _noteCandidates = lists.Notes;
        _boughtCandidates = lists.BoughtThrough;
        _paidCandidates = lists.PaidWith;
    }

    private IReadOnlyList<EleFi.Domain.Goals.Goal> _goals = [];
    private Guid? _goalId;
}
