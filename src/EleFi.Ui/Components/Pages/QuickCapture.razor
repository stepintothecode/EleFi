@page "/quick"
@using EleFi.Application.Abstractions
@using EleFi.Application.Transactions
@using EleFi.Application.Typeahead
@using EleFi.Domain.Containers
@using EleFi.Domain.Money
@using EleFi.Domain.Transactions
@using EleFi.Ui.Services
@implements IDisposable
@inject CaptureService Capturing
@inject IContainerRepository Containers
@inject IPartyRepository Parties
@inject IClock Clock
@inject EleReactions Ele
@inject UndoHistory Undo
@inject EditTransactionService Editing
@inject NavigationManager Nav
@layout EleFi.Ui.Components.Layout.BareLayout

@*
    Three taps, and out.

    Kind, then Amount, Source, Destination. The kind is a switch at the top, Debit unless
    changed, and it decides what the last two steps ask: who was paid, who paid, or which of
    the user's own containers the money moved into. Nothing else is asked, because everything else has a defensible
    default and asking for it is what makes the full form take thirty seconds instead of
    three. The result is a complete, real Transaction flagged Needs Review, not a draft:
    a guessed transaction that counts is worth more than a perfect one that never exists.

    After the third step it asks one thing: Done, which records it flagged for review, or
    Add other details, which opens the full form with everything typed so far filled in and
    nothing saved yet. Both use the moment the user started typing the amount, which is when
    the money moved, not the moment they finished.

    Reached from the home-screen widget, the Quick Settings tile, or the tab bar.
*@

<PageTitle>Quick capture</PageTitle>

<div class="quick">
    @*
        A cross, not the word. It sits where a close control is expected, reads instantly
        without being parsed, and leaves the eye free for the amount field below. The word
        is kept underneath it so the target is still unambiguous.
    *@
    <div class="quick-top">
        <span class="muted small">Quick capture</span>
        <span class="grow"></span>
        <UndoRedo Area="@UndoHistory.Transactions" />
        <button type="button" class="close-stack" aria-label="Cancel and go back" @onclick="Cancel">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
                 stroke-linecap="round" aria-hidden="true">
                <path d="M6 6l12 12M18 6L6 18" />
            </svg>
            <span>Cancel</span>
        </button>
    </div>

    @* Debit unless changed. The step names and both lists follow it. *@
    <div class="segmented quick-kind" role="tablist" aria-label="Kind">
        @foreach (var kind in Kinds)
        {
            <button type="button" role="tab" class="@(_kind == kind ? "on" : null)"
                    aria-selected="@(_kind == kind ? "true" : "false")"
                    @onclick="() => SetKind(kind)">@kind.DisplayName()</button>
        }
    </div>

    <div class="quick-steps" role="group" aria-label="Step @(_step + 1) of 3">
        @for (var i = 0; i < StepLabels.Length; i++)
        {
            var index = i;
            var state = index < _step || _finishing ? "done" : index == _step ? "on" : string.Empty;
            <button type="button"
                    class="quick-step @state"
                    style="@ArcStyle(index)"
                    disabled="@(index > _furthest)"
                    aria-current="@(index == _step ? "step" : null)"
                    @onclick="() => GoTo(index)">
                <span class="dot">@(index < _step || _finishing ? "✓" : (index + 1).ToString())</span>
                <span class="cap">@StepLabels[index]</span>
            </button>
        }
    </div>

    <div class="quick-stage" @key="(_finishing ? 3 : _step)" @ontouchstart="TouchStart" @ontouchend="TouchEnd">
        @if (_finishing)
        {
            <div class="quick-panel quick-finish">
                <p class="quick-summary">
                    <span class="amount">@AmountDisplay</span>
                    @if (_kind == TransactionKind.Credit)
                    {
                        @($"into {NameOf(_containerId)} from {_partyName.Trim()}")
                    }
                    else if (_kind == TransactionKind.SelfTransfer)
                    {
                        @($"from {NameOf(_containerId)} to {NameOf(_destinationId)}")
                    }
                    else
                    {
                        @($"from {NameOf(_containerId)} to {_partyName.Trim()}")
                    }
                </p>
                <p class="muted small">@StartedAt.Date.ToString("ddd d MMM") at @StartedAt.Time.ToString("HH:mm")</p>
                <p class="muted small">Done records it now, flagged for review. Add other details opens the full form with this filled in.</p>
            </div>
        }
        else if (_step == 0)
        {
            <div class="quick-panel">
                <label for="q-amount">How much?</label>
                <input id="q-amount" class="amount-input" type="text" inputmode="decimal"
                       placeholder="0.00" autocomplete="off" autofocus enterkeyhint="next"
                       @bind="_amountText" @bind:event="oninput" @bind:after="AmountTyped" @onkeydown="OnAmountKey" />
                <p class="muted small">@Clock.Today.ToString("ddd d MMM") at @Clock.TimeOfDay.ToString("HH:mm")</p>
            </div>
        }
        else if (_step == 1)
        {
            <div class="quick-panel">
                <label>@StepLabels[1]</label>
                @if (_containers.Count == 0)
                {
                    <p class="notice error">Add a container first. Quick capture needs one of yours to record against.</p>
                }
                else
                {
                    <ContainerChoices Containers="_containers" Selected="_containerId" OnChosen="ChooseContainer" />
                }
            </div>
        }
        else if (_kind == TransactionKind.SelfTransfer)
        {
            <div class="quick-panel">
                <label>Destination</label>
                @if (_containers.Count < 2)
                {
                    <p class="notice error">A transfer needs two containers. Add another one first.</p>
                }
                else
                {
                    <ContainerChoices Containers="DestinationChoices" Selected="_destinationId" OnChosen="ChooseDestination" />
                }
            </div>
        }
        else
        {
            <div class="quick-panel">
                <label for="q-to">@StepLabels[2]</label>
                <TypeaheadInput Id="q-to"
                                @bind-Value="_partyName"
                                Candidates="_partyCandidates"
                                PanelLabel="@(_kind == TransactionKind.Credit ? "People who pay you" : "People and places you pay")"
                                EnterKeyHint="done"
                                Placeholder="Zomato, Rahul, chai"
                                OnPicked="ChooseParty"
                                OnKeyDown="OnPartyKey" />
            </div>
        }
    </div>


    <div class="quick-actions @(_finishing ? "quick-actions-even" : null)">
        @if (_finishing)
        {
            <button class="btn-ghost grow quick-more" disabled="@_busy" @onclick="AddOtherDetails">Add other details</button>
            <button class="primary grow quick-done-button" disabled="@_busy" @onclick="AddAsync">Done</button>
        }
        else
        {
            @if (_step > 0)
            {
                <button class="btn-ghost" @onclick="StepBack">Back</button>
            }
            <button class="primary grow" disabled="@(!CanAdvance)" @onclick="Next">Next</button>
        }
    </div>

</div>


@code {
    private static readonly TransactionKind[] Kinds =
        [TransactionKind.Debit, TransactionKind.Credit, TransactionKind.SelfTransfer];

    // The capture form's words for each kind. Source and Destination for a transfer, never
    // To and From.
    private string[] StepLabels => _kind switch
    {
        TransactionKind.Credit => ["Amount", "Received into", "Received from"],
        TransactionKind.SelfTransfer => ["Amount", "Source", "Destination"],
        _ => ["Amount", "Paid from", "Paid to"],
    };

    private TransactionKind _kind = TransactionKind.Debit;
    private Guid _destinationId;

    // A transfer's destination is any container but its source.
    private IReadOnlyList<Container> DestinationChoices => [.. _containers.Where(c => c.Id != _containerId)];

    private string? NameOf(Guid id) => _containers.FirstOrDefault(c => c.Id == id)?.Name;


    /// <summary>The app's back handling, cascaded from the router.</summary>
    [CascadingParameter]
    public BackNavigator? Back { get; set; }


    private IReadOnlyList<Container> _containers = [];
    private IReadOnlyList<TypeaheadCandidate> _partyCandidates = [];

    private int _step;
    private int _furthest;
    private string _amountText = string.Empty;
    private Guid _containerId;
    private string _partyName = string.Empty;
    private bool _busy;

    // On the last question: Done, or Add other details.
    private bool _finishing;

    // When the user started on this one: when the money moved. Null until the amount is typed.
    private (DateOnly Date, TimeOnly Time)? _startedAt;

    private (DateOnly Date, TimeOnly Time) StartedAt => _startedAt ?? (Clock.Today, Clock.TimeOfDay);

    private string AmountDisplay =>
        MoneyText.TryParse(_amountText, Currency.Inr, out var money) ? MoneyText.ToDisplayString(money) : _amountText;

    // While past the first step, the back gesture steps back through the form rather than
    // leaving it and losing the amount.
    private IDisposable? _stepBackRegistration;

    private bool HasAmount => MoneyText.TryParse(_amountText, Currency.Inr, out var m) && m.Minor > 0;

    private bool CanAdvance => _step switch
    {
        0 => HasAmount,
        1 => _containerId != Guid.Empty,
        _ => _kind == TransactionKind.SelfTransfer
            ? _destinationId != Guid.Empty && _destinationId != _containerId
            : !string.IsNullOrWhiteSpace(_partyName),
    };

    protected override async Task OnInitializedAsync()
    {
        _containers = ContainerGrouping.InPickerOrder(await Containers.ListSelectableAsync());
        PickDefaults();
        await LoadCandidatesAsync();
    }

    // Sensible first choices for the kind. A spend is usually on the first card (picker order
    // puts cards first); money in usually lands in a bank, not on a card; a transfer usually
    // moves from a bank to something else, a card bill most of all.
    private void PickDefaults()
    {
        var first = _containers.FirstOrDefault();
        var firstAsset = _containers.FirstOrDefault(c => !c.IsLiability) ?? first;

        _containerId = (_kind == TransactionKind.Debit ? first : firstAsset)?.Id ?? Guid.Empty;
        _destinationId = _kind == TransactionKind.SelfTransfer
            ? (_containers.FirstOrDefault(c => c.IsLiability && c.Id != _containerId)
                ?? _containers.FirstOrDefault(c => c.Id != _containerId))?.Id ?? Guid.Empty
            : Guid.Empty;
    }

    // Switching kind keeps the amount and steps back to the source, since what the last two
    // steps mean has changed.
    private void SetKind(TransactionKind kind)
    {
        if (kind == _kind)
        {
            return;
        }

        _kind = kind;
        PickDefaults();
        _finishing = false;
        _furthest = System.Math.Min(_furthest, 1);
        if (_step > 1)
        {
            SetStep(1);
        }
    }

    public void Dispose() => ReleaseStepBack();

    private async Task LoadCandidatesAsync() =>
        _partyCandidates = TypeaheadCandidates.From(await Parties.ListExternalAsync());

    // The steps sit on an arc rather than a line. Three items is few enough that a curve
    // reads as a shape rather than a diagram, and it puts the active one nearest the thumb.
    private static string ArcStyle(int index)
    {
        double[] angles = [-52, 0, 52];
        var radians = angles[index] * System.Math.PI / 180.0;
        var x = System.Math.Sin(radians) * 110;
        var y = (1 - System.Math.Cos(radians)) * 62;

        return $"transform: translate({x.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)}px, "
             + $"{y.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)}px);";
    }

    private void GoTo(int index)
    {
        if (index <= _furthest)
        {
            _finishing = false;
            SetStep(index);
        }
    }

    // From the last question, back returns to "Paid to"; otherwise one step back.
    private void StepBack()
    {
        if (_finishing)
        {
            _finishing = false;
            SyncStepBack();
            return;
        }

        SetStep(System.Math.Max(0, _step - 1));
    }

    // Swiping the step sideways moves between steps: left for the next, right for the one
    // before. Only a clearly sideways swipe counts, so scrolling a list is never taken for one.
    private double? _touchX;
    private double _touchY;

    private void TouchStart(TouchEventArgs e)
    {
        if (e.Touches.Length == 1)
        {
            _touchX = e.Touches[0].ClientX;
            _touchY = e.Touches[0].ClientY;
        }
    }

    private void TouchEnd(TouchEventArgs e)
    {
        if (_touchX is not { } startX || e.ChangedTouches.Length == 0)
        {
            return;
        }

        _touchX = null;
        var dx = e.ChangedTouches[0].ClientX - startX;
        var dy = e.ChangedTouches[0].ClientY - _touchY;
        if (Math.Abs(dx) < 60 || Math.Abs(dx) < Math.Abs(dy) * 1.5)
        {
            return;
        }

        if (dx < 0)
        {
            Next();
        }
        else if (_step > 0 || _finishing)
        {
            StepBack();
        }
    }

    private void AmountTyped()
    {
        if (_startedAt is null && !string.IsNullOrWhiteSpace(_amountText))
        {
            _startedAt = (Clock.Today, Clock.TimeOfDay);
        }
    }

    private void SetStep(int step)
    {
        _step = step;
        SyncStepBack();
    }

    private void SyncStepBack()
    {
        if (_step > 0 && _stepBackRegistration is null)
        {
            _stepBackRegistration = Back?.Intercept(() =>
            {
                // The navigator has already dropped this registration before calling it.
                _stepBackRegistration = null;
                StepBack();
                StateHasChanged();
                return Task.CompletedTask;
            });
        }
        else if (_step == 0)
        {
            ReleaseStepBack();
        }
    }

    private void ReleaseStepBack()
    {
        _stepBackRegistration?.Dispose();
        _stepBackRegistration = null;
    }

    // Back to wherever quick capture was opened from, or home after a cold start from the
    // widget, and never forward into it again.
    private void Cancel()
    {
        if (Back is not null)
        {
            Back.Leave("/");
            return;
        }

        Nav.NavigateTo("/");
    }


    private void Next()
    {
        if (!CanAdvance)
        {
            return;
        }

        if (_step == 2)
        {
            _finishing = true;
            SyncStepBack();
            return;
        }

        SetStep(System.Math.Min(2, _step + 1));
        _furthest = System.Math.Max(_furthest, _step);
    }

    private void ChooseContainer(Guid id)
    {
        _containerId = id;
        Next();
    }

    // Choosing the destination answers the last step of a transfer.
    private void ChooseDestination(Guid id)
    {
        _destinationId = id;
        Next();
    }

    // Tapping a name is the answer to the last step, so it moves straight on to Done.
    private void ChooseParty(string name)
    {
        _partyName = name;
        Next();
    }

    private void OnAmountKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            Next();
        }
    }

    private void OnPartyKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            Next();
        }
    }

    private async Task AddAsync()
    {
        if (_busy || !CanAdvance)
        {
            return;
        }

        _busy = true;


        try
        {
            var saved = await SaveAsync();
            if (saved is null)
            {
                return;
            }

            // Ele is the only confirmation. "Recorded", never "Saved", which reads as money
            // put aside.
            var id = saved.Value.TransactionId;
            var shown = MoneyText.ToDisplayString(saved.Value.Amount);
            Undo.Push(
                UndoHistory.Transactions,
                $"recording {shown} with {saved.Value.Counterparty}",
                () => Editing.DeleteAsync(id),
                () => Editing.RestoreAsync(id, flagForReview: true));
            Ele.React(EleMoment.Recorded, shown, saved.Value.Counterparty);

            _amountText = string.Empty;
            _partyName = string.Empty;
            _startedAt = null;
            _finishing = false;
            _furthest = 0;
            SetStep(0);
            await LoadCandidatesAsync();

        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>
    /// Opens the full capture form with everything answered so far, and saves nothing.
    /// </summary>
    /// <remarks>
    /// Nothing is recorded until the full form is saved, so backing out of it leaves no half
    /// transaction behind. The moment the user started is handed over too, so the form shows
    /// when the money moved rather than when the details were added.
    /// </remarks>
    private void AddOtherDetails()
    {
        var started = StartedAt;
        var query = $"capture?amount={Uri.EscapeDataString(_amountText.Trim())}"
            + $"&container={_containerId}"
            + (_kind == TransactionKind.SelfTransfer
                ? $"&to={_destinationId}"
                : $"&party={Uri.EscapeDataString(_partyName.Trim())}")
            + (_kind switch
            {
                TransactionKind.Credit => "&kind=credit",
                TransactionKind.SelfTransfer => "&kind=transfer",
                _ => "&kind=debit",
            })
            + $"&date={started.Date.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture)}"
            + $"&time={started.Time.ToString("HH\\:mm", System.Globalization.CultureInfo.InvariantCulture)}";

        Nav.NavigateTo(query);
    }

    private async Task<(Guid TransactionId, Money Amount, string Counterparty)?> SaveAsync()
    {
        if (!MoneyText.TryParse(_amountText, Currency.Inr, out var amount) || amount.Minor <= 0)
        {
            Ele.Problem("Enter an amount greater than zero.");
            return null;
        }

        var containerParty = await Containers.PartyForAsync(_containerId);
        if (containerParty is null)
        {
            Ele.Problem("That container no longer exists. Pick another one.");
            return null;
        }

        // The kind is never stored: it follows from which two parties are which.
        Guid sourceId;
        Guid destinationId;
        string counterpartyName;
        if (_kind == TransactionKind.SelfTransfer)
        {
            var destination = await Containers.PartyForAsync(_destinationId);
            if (destination is null)
            {
                Ele.Problem("That destination container no longer exists. Pick another one.");
                return null;
            }

            (sourceId, destinationId) = (containerParty.Id, destination.Id);
            counterpartyName = NameOf(_destinationId) ?? "your other container";
        }
        else
        {
            var counterparty = await Parties.GetOrCreateExternalAsync(_partyName);
            (sourceId, destinationId) = _kind == TransactionKind.Credit
                ? (counterparty.Id, containerParty.Id)
                : (containerParty.Id, counterparty.Id);
            counterpartyName = counterparty.Name ?? _partyName;
        }

        var result = await Capturing.CaptureAsync(new CaptureRequest(
            sourceId,
            destinationId,
            amount.Minor,
            Currency.Inr.Code,
            amount.Minor,
            Currency.Inr.Code,
            StartedAt.Date,
            StartedAt.Time,
            // No labels. Quick capture asks three questions and labels are not one of
            // them, and an invented one would be worse than none now that unlabelled is
            // a real state.
            LabelIds: null,
            // Needs Review, because everything optional was skipped. It still counts
            // toward every balance immediately: this is a real transaction, not a draft.
            NeedsReview: true,
            CaptureSource: CaptureSource.Widget));

        if (!result.Succeeded)
        {
            Ele.Problem(result.Error!);
            return null;
        }

        return (result.Transaction!.Id, amount, counterpartyName);
    }
}
