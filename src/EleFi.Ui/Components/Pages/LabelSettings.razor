@page "/settings/labels"
@using EleFi.Application.Labels
@using EleFi.Domain.Labels
@using EleFi.Ui.Services
@inject LabelService LabelsService
@inject EleReactions Ele
@inject UndoHistory Undo

@*
    Labels, on a page of their own.

    They used to be a list in the middle of Settings, so every visit to Settings scrolled past
    every label. Settings now has one "Edit labels" button, and this is where it goes. Back
    returns to Settings.
*@

<PageTitle>Labels</PageTitle>

<div class="section-head">
    <h1>Labels</h1>
    <span class="row" style="gap:4px;">
        <UndoRedo Area="@UndoHistory.Labels" OnChanged="ReloadAsync" />
        <button class="btn-ghost add-label" @onclick="StartCreate">Add</button>
    </span>
</div>

<div class="card">
    @if (_labels.Count == 0)
    {
        <p class="muted small" style="margin:0;">No labels yet.</p>
    }
    else
    {
        @foreach (var label in _labels)
        {
            <div class="txn">
                <span class="swatch" style="background: @(label.Colour ?? "var(--ele-accent)")"></span>
                <div class="grow">
                    <div class="who">@label.Name</div>
                </div>
                <button class="btn-ghost btn-icon" aria-label="Rename @label.Name"
                        @onclick="() => StartEdit(label)">Edit</button>
                <button class="btn-ghost btn-icon danger" aria-label="Delete @label.Name"
                        @onclick="() => ConfirmDeleteAsync(label)">Delete</button>
            </div>
        }
    }
</div>

<p class="muted small">A transaction can carry as many labels as you like, or none at all.</p>

@* In a sheet. Appending a form below a long list meant scrolling past everything to find it,
   and nothing about it said a new thing had appeared. *@
<Modal Open="_editing is not null" Title="@(_editingId is null ? "New label" : "Rename label")" OnCancel="CancelEdit">
    <div class="field">
        <label for="label-name">Name</label>
        <input id="label-name" @bind="_editing" placeholder="Groceries" autocomplete="off" />
    </div>

    <div class="field">
        <label>Colour</label>
        <ColourPicker @bind-Value="_colour" SampleText="@_editing" />
    </div>

    <button class="primary btn-block" @onclick="SaveAsync">Save</button>
</Modal>

<Modal Open="_deleting is not null" Title="Delete this label?" OnCancel="() => _deleting = null">
    @if (_deleting is { } label)
    {
        <p class="small">
            <strong>@label.Name</strong> is on @_deletingUsage
            @(_deletingUsage == 1 ? "transaction" : "transactions").
        </p>
        <p class="small muted">
            Those transactions stay exactly as they are and their amounts do not change. They
            simply stop carrying this label.
        </p>
        <div class="row">
            <button class="btn-ghost grow" @onclick="() => _deleting = null">Keep it</button>
            <button class="primary danger grow" @onclick="DeleteAsync">Delete</button>
        </div>
    }
</Modal>

@code {

    private IReadOnlyList<Label> _labels = [];

    private string? _editing;
    private Guid? _editingId;
    private string _colour = ColourPicker.Presets[0];

    private Label? _deleting;
    private int _deletingUsage;

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ReloadAsync() => _labels = await LabelsService.ListAsync();

    private void StartCreate()
    {
        _editing = string.Empty;
        _editingId = null;
        _colour = ColourPicker.Presets[1];
    }

    private void StartEdit(Label label)
    {
        _editing = label.Name;
        _editingId = label.Id;
        _colour = ColourMath.Normalise(label.Colour) ?? ColourPicker.Presets[1];
    }

    private void CancelEdit()
    {
        _editing = null;
        _editingId = null;
    }

    private async Task SaveAsync()
    {
        var name = _editing ?? string.Empty;
        var colour = _colour;
        var previous = _editingId is { } editing ? _labels.FirstOrDefault(l => l.Id == editing) : null;
        var (oldName, oldColour) = (previous?.Name, previous?.Colour);

        var result = _editingId is { } id
            ? await LabelsService.UpdateAsync(id, name, colour)
            : await LabelsService.CreateAsync(name, colour);

        if (!result.Succeeded)
        {
            Ele.Problem(result.Error!);
            return;
        }

        var label = result.Label!;
        if (_editingId is null)
        {
            Undo.Push(
                UndoHistory.Labels,
                $"adding {label.Name}",
                async () => Checked(await LabelsService.DeleteAsync(label.Id)),
                () => LabelsService.RestoreAsync(label.Id, null));
            Ele.Say($"Added {label.Name}.");
        }
        else
        {
            Undo.Push(
                UndoHistory.Labels,
                $"renaming {oldName}",
                async () => Checked(await LabelsService.UpdateAsync(label.Id, oldName!, oldColour)),
                async () => Checked(await LabelsService.UpdateAsync(label.Id, name, colour)));
            Ele.Say($"Renamed to {label.Name}.");
        }

        CancelEdit();
        await ReloadAsync();
    }

    private async Task ConfirmDeleteAsync(Label label)
    {
        // Count first, so the confirmation can say what it will actually affect rather than
        // asking the user to guess.
        _deletingUsage = await LabelsService.UsageAsync(label.Id);
        _deleting = label;
    }

    private async Task DeleteAsync()
    {
        if (_deleting is not { } label)
        {
            return;
        }

        var result = await LabelsService.DeleteAsync(label.Id);
        _deleting = null;

        if (!result.Succeeded)
        {
            Ele.Problem(result.Error!);
            return;
        }

        // Undo puts the label back on exactly the transactions it was taken off.
        var detached = result.DetachedFrom ?? [];
        Undo.Push(
            UndoHistory.Labels,
            $"deleting {label.Name}",
            () => LabelsService.RestoreAsync(label.Id, detached),
            async () => Checked(await LabelsService.DeleteAsync(label.Id)));

        Ele.Say($"Deleted {label.Name}.", EleTone.Calm);
        await ReloadAsync();
    }

    private static void Checked(LabelResult result)
    {
        if (!result.Succeeded)
        {
            throw new InvalidOperationException(result.Error);
        }
    }
}
