@page "/transactions"
@using System.Globalization
@using EleFi.Application.Abstractions
@using EleFi.Application.Export
@using EleFi.Domain.Containers
@using EleFi.Domain.Filters
@using EleFi.Domain.Labels
@using EleFi.Domain.Money
@using EleFi.Domain.Transactions
@using EleFi.Ui.Services
@inject ToastService Toasts
@inject ITransactionRepository Ledger
@inject IContainerRepository Containers
@inject ILabelRepository Labels
@inject CsvExporter Exporter
@inject IFileShare FileShare
@inject TransactionListState State
@inject IClock Clock

@*
    All Transactions.

    The export button sits here rather than in settings, and it carries the live row count
    (FR-7.18, FR-7.19). That is not decoration: it is the visible proof that the export and
    the list are the same set. Change a filter and the number on the button changes with the
    list, because both come from one query (X1).

    The filter, the rows loaded and the row last opened are kept in TransactionListState, so
    opening a transaction and coming back lands exactly where the user left, not at the top
    of an unfiltered list.
*@

<PageTitle>All transactions</PageTitle>

<div class="section-head">
    <h1>All transactions</h1>
    <button class="btn-ghost" @onclick="() => _filtersOpen = true">
        Filters
        @if (!_filter.IsEmpty)
        {
            <span class="chip on small" style="min-height:auto;padding:2px 8px;">on</span>
        }
    </button>
</div>

@* Filters in a sheet. Done in place, they pushed the list off screen and every change made
   the page jump under the user's thumb. The count and the total update behind the sheet. *@
<Modal Open="_filtersOpen" Title="Filters" OnCancel="() => _filtersOpen = false">
    <h2 class="sheet-heading">Dates</h2>
    <div class="chips">
        @foreach (var preset in Presets)
        {
            <button class="chip @(_preset == preset ? "on" : string.Empty)" @onclick="() => ApplyPresetAsync(preset)">@preset.DisplayName()</button>
        }
        <button class="chip @(_preset == DatePreset.Custom ? "on" : string.Empty)" @onclick="() => _rangeOpen = true">
            @(_preset == DatePreset.Custom ? RangeText : "Custom range")
        </button>
    </div>

    <hr class="divider" />

    <h2 class="sheet-heading">Kind</h2>
    <div class="chips">
        @foreach (var kind in new[] { TransactionKind.Debit, TransactionKind.Credit, TransactionKind.SelfTransfer })
        {
            <button class="chip @(_filter.Kinds.Contains(kind) ? "on" : string.Empty)"
                    @onclick="() => ToggleKindAsync(kind)">@kind.DisplayName()</button>
        }
        <button class="chip @(_filter.NeedsReview == true ? "on" : string.Empty)" @onclick="ToggleReviewAsync">Needs review</button>
    </div>

    <hr class="divider" />

    <h2 class="sheet-heading">Container</h2>
    <div class="chips">
        @foreach (var container in _containers)
        {
            <button class="chip @(_filter.ContainerIds.Contains(container.Id) ? "on" : string.Empty)"
                    @onclick="() => ToggleContainerAsync(container.Id)">@container.Name</button>
        }
    </div>

    <hr class="divider" />

    <h2 class="sheet-heading">Label</h2>
    <div class="chips">
        @foreach (var label in _labels)
        {
            <button class="chip @(_filter.LabelIds.Contains(label.Id) ? "on" : string.Empty)"
                    @onclick="() => ToggleLabelAsync(label.Id)">@label.Name</button>
        }
        @* Labels are optional, so unlabelled is common and needs its own way in. *@
        <button class="chip @(_filter.UnlabelledOnly ? "on" : string.Empty)"
                @onclick="ToggleUnlabelledAsync">Unlabelled</button>
    </div>

    <hr class="divider" />

    <h2 class="sheet-heading">Search</h2>
    <input placeholder="Description, party, app..." value="@_filter.Search"
           @oninput="OnSearchAsync" autocomplete="off" />

    <div class="row" style="margin-top:16px;">
        @if (!_filter.IsEmpty)
        {
            <button class="btn-ghost" @onclick="ClearAsync">Clear all</button>
        }
        <button class="primary grow" @onclick="() => _filtersOpen = false">
            Show @_count @(_count == 1 ? "transaction" : "transactions")
        </button>
    </div>
</Modal>

<DateRangeSheet Open="_rangeOpen" Title="Custom range" Initial="_filter"
                OnApply="ApplyRangeAsync" OnCancel="() => _rangeOpen = false" />

<div class="card row between">
    <div>
        <div class="muted small">@(_filter.IsEmpty ? "Everything" : "Filtered")</div>
        <div>@_count @(_count == 1 ? "transaction" : "transactions")</div>
    </div>
    <button class="primary" disabled="@(_exporting || _count == 0)" @onclick="ExportAsync">
        @(_exporting ? "Exporting..." : $"Export {_count}")
    </button>
</div>

@if (_loading)
{
    <div class="card">
        @for (var i = 0; i < 5; i++)
        {
            <div class="skeleton" style="margin-bottom:10px; width:@(60 + (i * 7))%;"></div>
        }
    </div>
}
else if (_rows.Count == 0)
{
    <div class="card muted">
        @(_filter.IsEmpty
            ? "Nothing recorded yet. The Capture tab is where money gets in."
            : "No transactions match these filters.")
    </div>
}
else
{
    <div class="card">
        @foreach (var group in _rows.GroupBy(r => r.OccurredOn).OrderByDescending(g => g.Key))
        {
            <div class="date-header">@FormatDate(group.Key)</div>
            @foreach (var row in group)
            {
                <TransactionRow @key="row.Id" Row="row" Highlight="row.Id == _highlight" OnOpen="Remember" />
            }
        }

        @* The total of everything the filter selects, not just the rows loaded so far, so it
           does not change as the list is scrolled. Transfers between your own containers are
           neither in nor out, so they are left out (D1). *@
        <div class="list-total">
            <div>
                <div class="who">Total</div>
                <div class="meta">
                    In <span class="amount in">@MoneyText.ToDisplayString(Money.SignedMinor(_totals.InMinor, Currency.Inr))</span>
                    &middot; Out <span class="amount out">@MoneyText.ToDisplayString(Money.SignedMinor(_totals.OutMinor, Currency.Inr))</span>
                </div>
            </div>
            <div class="amount @(_totals.NetMinor < 0 ? "out" : "in")">
                @(_totals.NetMinor > 0 ? "+" : string.Empty)@MoneyText.ToDisplayString(Money.SignedMinor(_totals.NetMinor, Currency.Inr))
            </div>
        </div>
    </div>

    @if (_rows.Count < _count)
    {
        <button class="btn-ghost btn-block" @onclick="LoadMoreAsync">
            Show more (@(_count - _rows.Count) left)
        </button>
    }
}

@code {
    private const int PageSize = 50;

    private static readonly DatePreset[] Presets =
        [DatePreset.AllTime, DatePreset.Today, DatePreset.ThisWeek, DatePreset.ThisMonth, DatePreset.LastMonth, DatePreset.ThisFinancialYear];

    private TransactionFilter _filter = TransactionFilter.Empty;
    private IReadOnlyList<Transaction> _rows = [];
    private IReadOnlyList<Container> _containers = [];
    private IReadOnlyList<Label> _labels = [];
    private FlowTotals _totals;

    private int _count;
    private bool _loading = true;
    private bool _filtersOpen;
    private bool _rangeOpen;
    private bool _exporting;
    private DatePreset _preset = DatePreset.AllTime;
    private Guid? _highlight;

    private string RangeText =>
        $"{_filter.From:d MMM}{(_filter.FromTime is { } a ? $" {a:HH\\:mm}" : string.Empty)} to "
        + $"{_filter.To:d MMM}{(_filter.ToTime is { } b ? $" {b:HH\\:mm}" : string.Empty)}";

    protected override async Task OnInitializedAsync()
    {
        // The same order as every picker: cards, banks, the rest. No headings here, just order.
        _containers = ContainerGrouping.InPickerOrder(await Containers.ListSelectableAsync());
        _labels = await Labels.ListAsync();

        _filter = State.Filter;
        _preset = State.Preset;
        _highlight = State.TakeReturnTo();

        await ReloadAsync(Math.Max(PageSize, State.Loaded));
    }

    private async Task ReloadAsync(int take = PageSize)
    {
        _loading = true;

        // One query behind the count, the rows and the total, and the same one the exporter
        // calls. There is no second definition of "what is selected" anywhere (X1).
        _count = await Ledger.CountAsync(_filter);
        _rows = await Ledger.QueryAsync(_filter, 0, take);
        _totals = await Ledger.TotalsAsync(_filter);

        Keep();
        _loading = false;
    }

    private async Task LoadMoreAsync()
    {
        var more = await Ledger.QueryAsync(_filter, _rows.Count, PageSize);
        _rows = [.. _rows, .. more];
        Keep();
    }

    private void Keep()
    {
        State.Filter = _filter;
        State.Preset = _preset;
        State.Loaded = _rows.Count;
    }

    // Remembered on the way out, so the way back can scroll to it.
    private void Remember(Guid id) => State.ReturnTo = id;

    private async Task ApplyPresetAsync(DatePreset preset)
    {
        _preset = preset;
        _filter = _filter.WithPreset(preset, Clock.Today);
        await ReloadAsync();
    }

    private async Task ApplyRangeAsync(TransactionFilter range)
    {
        _rangeOpen = false;
        _preset = DatePreset.Custom;
        _filter = _filter with { From = range.From, FromTime = range.FromTime, To = range.To, ToTime = range.ToTime };
        await ReloadAsync();
    }

    private async Task ToggleKindAsync(TransactionKind kind)
    {
        var kinds = _filter.Kinds.ToList();
        if (!kinds.Remove(kind))
        {
            kinds.Add(kind);
        }

        _filter = _filter with { Kinds = kinds };
        await ReloadAsync();
    }

    private async Task ToggleReviewAsync()
    {
        _filter = _filter with { NeedsReview = _filter.NeedsReview == true ? null : true };
        await ReloadAsync();
    }

    private async Task ToggleContainerAsync(Guid id)
    {
        var ids = _filter.ContainerIds.ToList();
        if (!ids.Remove(id))
        {
            ids.Add(id);
        }

        _filter = _filter with { ContainerIds = ids };
        await ReloadAsync();
    }

    private async Task ToggleLabelAsync(Guid id)
    {
        var ids = _filter.LabelIds.ToList();
        if (!ids.Remove(id))
        {
            ids.Add(id);
        }

        _filter = _filter with { LabelIds = ids, UnlabelledOnly = false };
        await ReloadAsync();
    }

    private async Task ToggleUnlabelledAsync()
    {
        // Mutually exclusive with picking labels: "carries no label" and "carries this
        // label" cannot both be true, and offering the combination would return nothing.
        _filter = _filter with { UnlabelledOnly = !_filter.UnlabelledOnly, LabelIds = [] };
        await ReloadAsync();
    }

    private async Task OnSearchAsync(ChangeEventArgs e)
    {
        _filter = _filter with { Search = e.Value?.ToString() };
        await ReloadAsync();
    }

    private async Task ClearAsync()
    {
        _filter = TransactionFilter.Empty;
        _preset = DatePreset.AllTime;
        await ReloadAsync();
    }

    private async Task ExportAsync()
    {
        _exporting = true;

        try
        {
            var names = _containers
                .Where(c => _filter.ContainerIds.Contains(c.Id))
                .Select(c => c.Name)
                .ToList();

            var export = await Exporter.ExportAsync(_filter, null, names);
            await FileShare.ShareAsync(export.FileName, export.Contents, "Export transactions");

            Toasts.Ok($"{export.RowCount} {(export.RowCount == 1 ? "row" : "rows")} written to {export.FileName}.");
        }
        catch (Exception ex)
        {
            Toasts.Error($"The export did not finish: {ex.Message}");
        }
        finally
        {
            _exporting = false;
        }
    }

    private string FormatDate(DateOnly date)
    {
        if (date == Clock.Today)
        {
            return "Today";
        }

        return date == Clock.Today.AddDays(-1)
            ? "Yesterday"
            : date.ToString("ddd d MMM yyyy", CultureInfo.InvariantCulture);
    }
}
