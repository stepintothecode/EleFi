@page "/suggestions"
@using EleFi.Application.Abstractions
@using EleFi.Application.Labels
@using EleFi.Application.Suggestions
@using EleFi.Application.Typeahead
@using EleFi.Domain.Alerts
@using EleFi.Domain.Containers
@using EleFi.Domain.Labels
@using EleFi.Domain.Money
@using EleFi.Domain.Transactions
@using EleFi.Ui.Services
@implements IDisposable
@inject ToastService Toasts
@inject SuggestionService SuggestionInbox
@inject IContainerRepository Containers
@inject IPartyRepository Parties
@inject LabelService LabelList
@inject ISuggestionPromptSurface Prompts
@inject NavigationManager Nav
@inject IClock Clock

@*
    The Suggestion Inbox: payments EleFi has spotted and nobody has confirmed yet.

    Each card is a Capture Suggestion: what a bank SMS, a Payment App notification, or both
    said happened. None of it is money yet. Only "Add it" turns one into a transaction, and
    that is the whole of SM2: the app never books a payment because something told it so.

    Below the list, the permission-free path (FR-11.22): paste a bank message and see what
    EleFi makes of it. It needs no permission, which is why it was built first and why it
    is the version of this feature that works everywhere.
*@

<PageTitle>To confirm</PageTitle>

<h1>To confirm</h1>
<p class="muted small">
    Payments spotted in your bank SMS and payment apps. Nothing here counts until you add it.
</p>

@if (_loading)
{
    <div class="card"><div class="skeleton" style="width:60%;"></div></div>
}
else if (_pending.Count == 0)
{
    <div class="card muted small">
        Nothing waiting. When a bank SMS or a payment app reports a payment, it appears here
        for you to check and add.
    </div>
}

@foreach (var suggestion in _pending)
{
    var edits = EditsFor(suggestion);
    var cardBill = suggestion.Direction == TransactionKind.SelfTransfer;
    var debit = suggestion.Direction != TransactionKind.Credit;
    <div class="card enter" @key="suggestion.Id">
        <div class="row between">
            <div>
                <div class="amount @(cardBill ? "transfer" : debit ? "out" : "in")">
                    @(debit ? "-" : "+")@MoneyText.ToDisplayString(suggestion.Amount)
                </div>
                <div class="meta">
                    @(suggestion.OccurredOn?.ToString("ddd d MMM") ?? "no date")@(suggestion.OccurredAtTime is { } time ? $" at {time:HH:mm}" : string.Empty)
                    @if (cardBill)
                    {
                        <span> &middot; card bill, not spending</span>
                    }
                </div>
            </div>
            <div class="evidence" aria-label="Reported by">
                @if (suggestion.Evidence.HasFlag(AlertEvidence.Sms))
                {
                    <span>Bank SMS</span>
                }
                @if (suggestion.Evidence.HasFlag(AlertEvidence.PaymentApp))
                {
                    <span>@(suggestion.PaymentAppName ?? "Payment app")</span>
                }
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(suggestion.Note))
        {
            <p class="small" style="margin:10px 0 0;">&ldquo;@suggestion.Note&rdquo;</p>
        }

        @if (!cardBill)
        {
            <div class="field" style="margin-top:12px;">
                <label for="who-@suggestion.Id">@(debit ? "Paid to" : "Received from")</label>
                <TypeaheadInput Id="@($"who-{suggestion.Id}")"
                                Value="@edits.Counterparty"
                                ValueChanged="v => edits.Counterparty = v"
                                Candidates="_partyCandidates"
                                IdleCount="0" />
            </div>
        }

        @* An unmatched alert offers "Choose one" rather than a default (SM11): the message did
           not name a card or bank account EleFi recognises, so it is not guessing. *@
        <div class="field" style="@(cardBill ? "margin-top:12px;" : null)">
            <label for="from-@suggestion.Id">@(debit ? "Paid from" : "Received into")</label>
            <ContainerSelect Id="@($"from-{suggestion.Id}")" Containers="_containers" Placeholder="Choose one"
                             Value="edits.ContainerId" ValueChanged="id => edits.ContainerId = id" />
        </div>

        @if (cardBill)
        {
            @* D1: paying a card from a bank is moving your own money. Recorded as a Self
               Transfer to the card, so the purchases on it are not counted a second time. *@
            <div class="field">
                <label for="card-@suggestion.Id">Card paid <span class="muted small">(@suggestion.CounterpartyText)</span></label>
                <ContainerSelect Id="@($"card-{suggestion.Id}")" Containers="_cards" Placeholder="Choose the card"
                                 Value="edits.CardId" ValueChanged="id => edits.CardId = id" />
            </div>
        }
        else
        {
            @* The same picker the capture form uses. A suggestion becomes an ordinary
               transaction the moment it is confirmed, so offering it a lesser set of choices
               here would only mean editing it again afterwards. *@
            <div class="field">
                <label>Labels <span class="muted small">(optional)</span></label>
                <LabelPicker Labels="_labels" Selected="edits.LabelIds" SelectedChanged="ids => edits.LabelIds = ids" />
            </div>
        }

        <div class="row">
            <button class="primary grow" disabled="@_busy" @onclick="() => ConfirmAsync(suggestion)">Add it</button>
            <button class="btn-ghost" disabled="@_busy" @onclick="() => DismissAsync(suggestion.Id)">Dismiss</button>
        </div>
    </div>
}

<details class="paste" style="margin-top:20px;">
    <summary>Paste a bank message</summary>
    <p class="muted small">
        Read here on the device. Nothing of the message itself is kept, and one-time passcodes
        are never read.
    </p>
    <div class="card">
        <div class="field">
            <label for="sender">Sender</label>
            <input id="sender" @bind="_sender" placeholder="VM-HDFCBK" autocomplete="off" />
        </div>
        <div class="field">
            <label for="body">Message</label>
            <textarea id="body" rows="4" @bind="_body"
                      placeholder="Rs.450.00 debited from a/c XX4417 on 30-08-26 to ZOMATO"></textarea>
        </div>
        <button class="primary btn-block" disabled="@_busy" @onclick="ParseAsync">Read it</button>
    </div>

    @if (_message is not null)
    {
        <div class="notice @(_ok ? "ok" : "error")" role="status">@_message</div>
    }
</details>

@code {
    private IReadOnlyList<CaptureSuggestion> _pending = [];
    private IReadOnlyList<Container> _containers = [];
    private IReadOnlyList<Container> _cards = [];
    private IReadOnlyList<Label> _labels = [];
    private IReadOnlyList<TypeaheadCandidate> _partyCandidates = [];

    // What the user has changed on each card before pressing Add, by suggestion.
    private readonly Dictionary<Guid, CardEdits> _edits = [];

    private string _sender = string.Empty;
    private string _body = string.Empty;
    private string? _message;
    private bool _ok;
    private bool _busy;
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        // A Suggestion Prompt tapped while this page is already open navigates to the same
        // route, which Blazor treats as nothing happening. Reloading on it shows the new one.
        Nav.LocationChanged += OnLocationChanged;

        _containers = ContainerGrouping.InPickerOrder(await Containers.ListSelectableAsync());
        _cards = _containers.Where(c => c.Kind == ContainerKind.CreditCard).ToList();
        _labels = await LabelList.ListByUsageAsync();
        _partyCandidates = TypeaheadCandidates.From(await Parties.ListExternalAsync());

        await ReloadAsync();
        _loading = false;
    }

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        if (Nav.ToBaseRelativePath(e.Location).StartsWith("suggestions", StringComparison.Ordinal))
        {
            _ = InvokeAsync(async () =>
            {
                await ReloadAsync();
                StateHasChanged();
            });
        }
    }

    private async Task ReloadAsync()
    {
        // Expired suggestions are destroyed before the list is drawn, so nothing stale is
        // ever offered (SM5, FR-11.12).
        await SuggestionInbox.PurgeExpiredAsync();
        _pending = await SuggestionInbox.PendingAsync();
    }

    private CardEdits EditsFor(CaptureSuggestion suggestion)
    {
        if (!_edits.TryGetValue(suggestion.Id, out var edits))
        {
            edits = new CardEdits();
            _edits[suggestion.Id] = edits;
        }

        // A second alert merged in after the card was first drawn brings a better payee or
        // the container. It flows into the card unless the user has already typed over it.
        edits.Follow(suggestion.CounterpartyText ?? string.Empty, suggestion.ContainerId ?? Guid.Empty);
        return edits;
    }

    private async Task ParseAsync()
    {
        _message = null;
        _busy = true;

        try
        {
            var result = await SuggestionInbox.IngestAsync(_sender, _body, Clock.UtcNow, Currency.Inr);

            _ok = result.Created;
            _message = result.Created
                ? "Read it. Check the details above, then add it."
                : result.Reason;

            if (result.Created)
            {
                _body = string.Empty;
                await ReloadAsync();
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ConfirmAsync(CaptureSuggestion suggestion)
    {
        var edits = EditsFor(suggestion);

        if (edits.ContainerId == Guid.Empty)
        {
            Toasts.Error("Choose which container this came from.");
            return;
        }

        _busy = true;
        try
        {
            // No fallback label. Labels are optional, so recording it unlabelled is honest
            // where picking one on the user's behalf would be a guess.
            var result = await SuggestionInbox.ConfirmAsync(
                suggestion.Id,
                edits.ContainerId,
                edits.Counterparty,
                edits.LabelIds,
                edits.CardId == Guid.Empty ? null : edits.CardId);

            if (!result.Succeeded)
            {
                Toasts.Error(result.Error!);
                return;
            }

            Prompts.Withdraw(suggestion.Id);
            _edits.Remove(suggestion.Id);
            Toasts.Ok($"Added {MoneyText.ToDisplayString(suggestion.Amount)}.");
            _partyCandidates = TypeaheadCandidates.From(await Parties.ListExternalAsync());
            await ReloadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DismissAsync(Guid id)
    {
        // Destroyed, not soft-deleted (SM5). It is machine output you said no to.
        await SuggestionInbox.DismissAsync(id);
        Prompts.Withdraw(id);
        _edits.Remove(id);
        await ReloadAsync();
    }

    /// <summary>The user's changes to one inbox card, kept until Add or Dismiss.</summary>
    private sealed class CardEdits
    {
        private string? _seenCounterparty;
        private Guid _seenContainer;

        public string Counterparty { get; set; } = string.Empty;

        public Guid ContainerId { get; set; }

        public Guid CardId { get; set; }

        public IReadOnlyList<Guid> LabelIds { get; set; } = [];

        // Take the suggestion's latest facts for any field the user has left as it was.
        public void Follow(string counterparty, Guid containerId)
        {
            if (_seenCounterparty is null || Counterparty == _seenCounterparty)
            {
                Counterparty = counterparty;
            }

            if (_seenCounterparty is null || ContainerId == _seenContainer)
            {
                ContainerId = containerId;
            }

            _seenCounterparty = counterparty;
            _seenContainer = containerId;
        }
    }
}
