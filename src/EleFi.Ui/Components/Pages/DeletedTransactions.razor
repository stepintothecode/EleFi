@page "/settings/deleted"
@using EleFi.Application.Transactions
@using EleFi.Domain.Money
@using EleFi.Domain.Transactions
@using EleFi.Ui.Services
@inject EditTransactionService Editing
@inject UndoHistory Undo
@inject EleReactions Ele

@*
    Deleted transactions, and the way back.

    Deleting is soft: the row leaves every balance, list and export at once but is kept, and
    its history records the deletion. This is the only place those rows appear. Restoring
    one puts it back everywhere, flagged for review, because it was deleted for a reason.
*@

<PageTitle>Deleted transactions</PageTitle>

<RefreshOnResume OnResumed="ReloadAsync" />

<div class="section-head">
    <h1>Deleted</h1>
    <span class="row" style="gap:4px;">
        <UndoRedo Area="@UndoHistory.Transactions" OnChanged="ReloadAsync" />
        @if (_deleted.Count > 0)
        {
            <button class="btn-ghost restore-all" disabled="@_busy" @onclick="RestoreAllAsync">Restore all</button>
        }
    </span>
</div>

@if (_loading)
{
    <div class="card"><div class="skeleton" style="width:60%;"></div></div>
}
else if (_deleted.Count == 0)
{
    <EleCentre Title="Nothing deleted.">A transaction you delete waits here until you restore it.</EleCentre>
}
else
{
    <div class="card">
        @foreach (var row in _deleted)
        {
            <div class="txn" @key="row.Id">
                <div class="grow">
                    <div class="who">@Counterparty(row)</div>
                    <div class="meta">@row.OccurredOn.ToString("d MMM yyyy") &middot; deleted @row.DeletedAt?.ToLocalTime().ToString("d MMM")</div>
                </div>
                <div class="amount">@MoneyText.ToDisplayString(row.SourceAmount)</div>
                <button class="btn-ghost btn-icon" disabled="@_busy" aria-label="Restore @Counterparty(row)"
                        @onclick="() => RestoreAsync(row.Id)">Restore</button>
            </div>
        }
    </div>
    <p class="muted small">A restored transaction comes back flagged for review.</p>
}

@code {
    private IReadOnlyList<Transaction> _deleted = [];
    private bool _loading = true;
    private bool _busy;

    protected override async Task OnInitializedAsync()
    {
        _deleted = await Editing.DeletedAsync();
        _loading = false;
    }

    private async Task RestoreAsync(Guid id)
    {
        _busy = true;
        try
        {
            var row = _deleted.FirstOrDefault(t => t.Id == id);
            await Editing.RestoreAsync(id);
            Undo.Push(
                UndoHistory.Transactions,
                $"restore of {(row is null ? "the transaction" : Counterparty(row))}",
                () => Editing.DeleteAsync(id),
                () => Editing.RestoreAsync(id));
            Ele.React(EleMoment.Restored, row is null ? null : MoneyText.ToDisplayString(row.SourceAmount), row is null ? null : Counterparty(row));
            _deleted = await Editing.DeletedAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RestoreAllAsync()
    {
        _busy = true;
        try
        {
            var ids = _deleted.Select(t => t.Id).ToList();
            var count = await Editing.RestoreAllAsync();
            Undo.Push(
                UndoHistory.Transactions,
                $"restore of {count} transactions",
                async () =>
                {
                    foreach (var id in ids)
                    {
                        await Editing.DeleteAsync(id);
                    }
                },
                async () =>
                {
                    foreach (var id in ids)
                    {
                        await Editing.RestoreAsync(id);
                    }
                });
            Ele.React(EleMoment.Restored, about: $"{count} transactions");
            _deleted = await Editing.DeletedAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ReloadAsync() => _deleted = await Editing.DeletedAsync();

    private static string Counterparty(Transaction row) =>
        row.SourceParty is null || row.DestinationParty is null
            ? "Transaction"
            : row.Kind switch
            {
                TransactionKind.Debit => row.DestinationParty.Name ?? "Unknown",
                TransactionKind.Credit => row.SourceParty.Name ?? "Unknown",
                _ => "Transfer between containers",
            };
}
