@page "/capture"
@using EleFi.Application.Abstractions
@using EleFi.Application.Labels
@using EleFi.Application.Transactions
@using EleFi.Application.Typeahead
@using EleFi.Domain.Containers
@using EleFi.Domain.Labels
@using EleFi.Domain.Money
@using EleFi.Domain.Transactions
@using EleFi.Ui.Services
@inject UndoHistory Undo
@inject EditTransactionService Editing
@inject EleReactions Ele
@inject CaptureService Capturing
@inject IContainerRepository Containers
@inject LabelService LabelList
@inject IPartyRepository Parties
@inject IAppRepository Apps
@inject IClock Clock
@inject EleFi.Application.Planning.PlanService Planner
@inject EleFi.Application.Goals.GoalService Goals
@inject ITransactionRepository Transactions
@inject NavigationManager Nav
@inject FormSuggestions Suggest

@*
    The core screen. Everything else exists to make this worth doing.

    Amount first and focused, kind as three chips that pre-filter the pickers, and Save and
    add another so a week's backlog is not painful. The kind chips never become a stored
    field: they only decide which way round the container and counterparty go, and the real
    kind is still derived from the two parties.

    Quick capture can hand over what it has gathered through the query string, so "Add other
    details" there lands here with the amount and the container already filled in.
*@

<PageTitle>Capture</PageTitle>

<div class="section-head">
    <h1>Record a transaction</h1>
    <UndoRedo Area="@UndoHistory.Transactions" />
</div>

@*
    The blocker is stated here, before anything is typed, rather than after Save.
    Discovering at the end of a form that the first field was impossible is the most
    annoying way to learn it.
*@
@if (!_loading && _containers.Count == 0)
{
    <div class="notice error" role="alert">
        <strong>No containers yet.</strong>
        Money has to come from somewhere, so add the bank account or wallet you use most first.
        <a class="btn btn-ghost btn-block" href="containers" style="margin-top:10px;">Add a container</a>
    </div>
}

<div class="card">
    <div class="field">
        <label for="amount">Amount</label>
        <input id="amount" class="amount-input" type="text" inputmode="decimal"
               placeholder="0.00" autocomplete="off" @bind="_amountText" @bind:event="oninput" />
    </div>

    <div class="chips" style="margin-bottom: 14px;" role="group" aria-label="Kind">
        @foreach (var kind in Kinds)
        {
            <button type="button" class="chip @(_kind == kind ? "on" : string.Empty)"
                    @onclick="() => SetKind(kind)">@kind.DisplayName()</button>
        }
    </div>

    @if (_kind == TransactionKind.SelfTransfer)
    {
        <div class="field">
            <label for="from">Source container</label>
            <ContainerSelect Id="from" Title="Source container" Containers="_containers" @bind-Value="_containerId" />
        </div>
        <div class="field">
            <label for="to">Destination container</label>
            <ContainerSelect Id="to" Title="Destination container" Containers="_containers" @bind-Value="_destinationContainerId" />
        </div>
    }
    else
    {
        <div class="field">
            <label for="container">@(_kind == TransactionKind.Debit ? "Paid from" : "Received into")</label>
            @if (_containers.Count == 0)
            {
                <div class="empty-field">
                    Nothing to pick yet.
                    <a href="containers">Add a container</a> and this fills in.
                </div>
            }
            else
            {
                <ContainerSelect Id="container" Title="@(_kind == TransactionKind.Debit ? "Paid from" : "Received into")" Containers="_containers" @bind-Value="_containerId" />
            }
        </div>

        <div class="field">
            <label for="party">@(_kind == TransactionKind.Debit ? "Paid to" : "Received from")</label>
            <TypeaheadInput Id="party"
                            Value="@_partyName"
                            ValueChanged="PartyChangedAsync"
                            Candidates="_partyCandidates"
                            PanelLabel="@(_kind == TransactionKind.Debit ? "People and places you pay" : "People who pay you")"
                            Placeholder="Zomato, Rahul, landlord..." />
        </div>

        <div class="field">
            <label>Labels <span class="muted small">(optional, pick any)</span></label>
            <LabelPicker Labels="_labels" Selected="_labelIds" SelectedChanged="ids => _labelIds = ids" />
        </div>
    }

    @* Both default to the device clock, because the overwhelmingly common case is
       recording something that just happened. *@
    <div class="row">
        <div class="field grow">
            <label for="date">Date</label>
            <input id="date" type="date" max="@Clock.Today.ToString("yyyy-MM-dd")" @bind="_date" />
        </div>
        <div class="field grow">
            <label for="time">Time</label>
            <input id="time" type="time" @bind="_time" />
        </div>
    </div>

    <div class="field">
        <div class="field-head">
            <label for="marketplace">Bought through <span class="muted small">(optional)</span></label>
            <AppRoleInfo />
        </div>
        <TypeaheadInput Id="marketplace" @bind-Value="_marketplaceAppName" Candidates="_boughtCandidates"
                        IdleCount="3" PanelLabel="Apps" Placeholder="Zomato, Amazon, Uber" />
    </div>

    <div class="field">
        <div class="field-head">
            <label for="payment">Paid with <span class="muted small">(optional)</span></label>
            <AppRoleInfo Payment="true" />
        </div>
        <TypeaheadInput Id="payment" @bind-Value="_paymentAppName" Candidates="_paidCandidates"
                        IdleCount="3" PanelLabel="Apps" Placeholder="GPay, Cash, Net Banking" />
    </div>

    <div class="field">
        <label for="note">Note <span class="muted small">(optional)</span></label>
        <TypeaheadInput Id="note" Value="@(_description ?? string.Empty)" ValueChanged="v => _description = v"
                        Candidates="_noteCandidates" IdleCount="3" OffersNew="false" Capitalize="sentences"
                        EnterKeyHint="done" PanelLabel="Notes used before" Placeholder="What was it for?" />
    </div>

    @if (_goals.Count > 0)
    {
        <div class="field">
            <label for="goal">Counts toward <span class="muted small">(optional)</span></label>
            <select id="goal" @bind="_goalId">
                <option value="">No goal</option>
                @foreach (var goal in _goals)
                {
                    <option value="@goal.Id">@goal.Name</option>
                }
            </select>
        </div>
    }

    @* "Record", not "Save": next to an amount, "Save ₹450" reads as putting money aside. *@
    <div class="stack">
        <button class="primary btn-block" disabled="@_busy" @onclick="() => SaveAsync(false)">Record</button>
        <button class="btn-ghost btn-block" disabled="@_busy" @onclick="() => SaveAsync(true)">Record and add another</button>
    </div>
</div>

@code {
    private static readonly TransactionKind[] Kinds =
        [TransactionKind.Debit, TransactionKind.Credit, TransactionKind.SelfTransfer];

    /// <summary>An amount handed over by quick capture, as typed there.</summary>
    [SupplyParameterFromQuery(Name = "amount")]
    public string? AmountQuery { get; set; }

    /// <summary>A container handed over by quick capture or a plan.</summary>
    [SupplyParameterFromQuery(Name = "container")]
    public Guid? ContainerQuery { get; set; }

    /// <summary>The plan this capture records. Saving ticks it off against the result.</summary>
    [SupplyParameterFromQuery(Name = "plan")]
    public Guid? PlanQuery { get; set; }

    /// <summary>A counterparty handed over by a plan.</summary>
    [SupplyParameterFromQuery(Name = "party")]
    public string? PartyQuery { get; set; }

    /// <summary>debit, credit or transfer, handed over by a plan.</summary>
    [SupplyParameterFromQuery(Name = "kind")]
    public string? KindQuery { get; set; }

    /// <summary>A destination container for a transfer, handed over by a plan.</summary>
    [SupplyParameterFromQuery(Name = "to")]
    public Guid? ToQuery { get; set; }

    /// <summary>A note handed over by a plan.</summary>
    [SupplyParameterFromQuery(Name = "note")]
    public string? NoteQuery { get; set; }

    /// <summary>The goal this capture puts money toward. Saving attributes the result to it.</summary>
    [SupplyParameterFromQuery(Name = "goal")]
    public Guid? GoalQuery { get; set; }

    /// <summary>The day, as yyyy-MM-dd, when quick capture started: when the money moved.</summary>
    [SupplyParameterFromQuery(Name = "date")]
    public string? DateQuery { get; set; }

    /// <summary>The time, as HH:mm, when quick capture started.</summary>
    [SupplyParameterFromQuery(Name = "time")]
    public string? TimeQuery { get; set; }

    /// <summary>Label ids, comma separated, handed over by a plan.</summary>
    [SupplyParameterFromQuery(Name = "labels")]
    public string? LabelsQuery { get; set; }

    private IReadOnlyList<EleFi.Domain.Goals.Goal> _goals = [];
    private Guid? _goalId;

    private IReadOnlyList<Container> _containers = [];
    private IReadOnlyList<Label> _labels = [];
    private IReadOnlyList<TypeaheadCandidate> _partyCandidates = [];
    private IReadOnlyList<TypeaheadCandidate> _boughtCandidates = [];
    private IReadOnlyList<TypeaheadCandidate> _paidCandidates = [];
    private SuggestionPools? _pools;

    private TransactionKind _kind = TransactionKind.Debit;
    private string _amountText = string.Empty;
    private Guid _containerId;
    private Guid _destinationContainerId;
    private IReadOnlyList<Guid> _labelIds = [];
    private string _partyName = string.Empty;
    private string _paymentAppName = string.Empty;
    private string _marketplaceAppName = string.Empty;
    private string? _description;
    private DateTime _date = DateTime.Today;

    // TimeOnly, not a string: Blazor binds <input type="time"> to it directly, and a
    // string round-trip would reintroduce the parsing this type exists to avoid.
    private TimeOnly? _time;

    private bool _busy;
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        // In picker order, so the pre-selected container is the first one drawn.
        _containers = ContainerGrouping.InPickerOrder(await Containers.ListSelectableAsync());
        _labels = await LabelList.ListByUsageAsync();
        await LoadCandidatesAsync();

        _containerId = _containers.FirstOrDefault()?.Id ?? Guid.Empty;
        _destinationContainerId = _containers.Skip(1).FirstOrDefault()?.Id ?? _containerId;

        // Whatever quick capture had, it hands over rather than making the user type it twice.
        _amountText = AmountQuery ?? string.Empty;
        _partyName = PartyQuery ?? string.Empty;
        _description = NoteQuery;
        _kind = KindQuery switch
        {
            "credit" => TransactionKind.Credit,
            "transfer" => TransactionKind.SelfTransfer,
            _ => TransactionKind.Debit,
        };

        if (ToQuery is { } to && _containers.Any(c => c.Id == to))
        {
            _destinationContainerId = to;
        }
        if (ContainerQuery is { } handed && _containers.Any(c => c.Id == handed))
        {
            _containerId = handed;
        }

        // Now, from the device, because that is what someone recording a purchase means. When
        // quick capture hands over, its moment wins: that is when the money moved, not the
        // moment the user tapped through to add details.
        _date = Clock.Today.ToDateTime(TimeOnly.MinValue);
        _time = Clock.TimeOfDay;
        if (DateOnly.TryParseExact(DateQuery, "yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture,
                System.Globalization.DateTimeStyles.None, out var handedDate))
        {
            _date = handedDate.ToDateTime(TimeOnly.MinValue);
        }

        if (TimeOnly.TryParseExact(TimeQuery, "HH:mm", System.Globalization.CultureInfo.InvariantCulture,
                System.Globalization.DateTimeStyles.None, out var handedTime))
        {
            _time = handedTime;
        }

        await LoadNoteCandidatesAsync();

        // A plan's labels, so the transaction carries them without picking them again.
        _labelIds = (LabelsQuery ?? string.Empty)
            .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Select(text => Guid.TryParse(text, out var id) ? id : Guid.Empty)
            .Where(id => id != Guid.Empty && _labels.Any(l => l.Id == id))
            .Distinct()
            .ToList();

        _goals = await Goals.AttributableAsync();
        if (GoalQuery is { } goalId && _goals.Any(g => g.Id == goalId))
        {
            _goalId = goalId;
        }

        _loading = false;
    }

    // The whole history, loaded once. Typing then ranks it in memory, so the field never
    // waits on the database between keystrokes.
    private async Task LoadCandidatesAsync()
    {
        _partyCandidates = TypeaheadCandidates.From(await Parties.ListExternalAsync());
        _pools = await Suggest.LoadAsync();
    }

    // Labels no longer restrict which kind they suit, so switching kind leaves them alone.
    private void SetKind(TransactionKind kind) => _kind = kind;

    private async Task SaveAsync(bool addAnother)
    {
        if (_containers.Count == 0)
        {
            Ele.Problem("Add a container first. EleFi needs somewhere for the money to come from or go to.");
            return;
        }

        if (!MoneyText.TryParse(_amountText, Currency.Inr, out var amount) || amount.Minor <= 0)
        {
            Ele.Problem("Enter an amount greater than zero.");
            return;
        }

        _busy = true;
        try
        {
            var containerParty = await Containers.PartyForAsync(_containerId);
            if (containerParty is null)
            {
                Ele.Problem("That container no longer exists. Pick another one.");
                return;
            }

            Guid sourceId;
            Guid destinationId;

            if (_kind == TransactionKind.SelfTransfer)
            {
                var destinationParty = await Containers.PartyForAsync(_destinationContainerId);
                if (destinationParty is null)
                {
                    Ele.Problem("That destination container no longer exists. Pick another one.");
                    return;
                }

                (sourceId, destinationId) = (containerParty.Id, destinationParty.Id);
            }
            else
            {
                if (string.IsNullOrWhiteSpace(_partyName))
                {
                    Ele.Problem(_kind == TransactionKind.Debit
                        ? "Who was it paid to?"
                        : "Who was it received from?");
                    return;
                }

                // Auto-created on first use, so capture never stalls to "create the party
                // first" - one of the interactions the three-second budget cannot afford.
                var external = await Parties.GetOrCreateExternalAsync(_partyName);

                (sourceId, destinationId) = _kind == TransactionKind.Debit
                    ? (containerParty.Id, external.Id)
                    : (external.Id, containerParty.Id);
            }

            Guid? paymentAppId = null;
            if (!string.IsNullOrWhiteSpace(_paymentAppName))
            {
                paymentAppId = (await Apps.GetOrCreateAsync(_paymentAppName)).Id;
            }

            // One shared pool feeds both roles, so a name typed in either box is suggested
            // in the other afterwards.
            Guid? marketplaceAppId = null;
            if (!string.IsNullOrWhiteSpace(_marketplaceAppName))
            {
                marketplaceAppId = (await Apps.GetOrCreateAsync(_marketplaceAppName)).Id;
            }

            var result = await Capturing.CaptureAsync(new CaptureRequest(
                sourceId,
                destinationId,
                amount.Minor,
                Currency.Inr.Code,
                amount.Minor,
                Currency.Inr.Code,
                DateOnly.FromDateTime(_date),
                _time,
                _labelIds,
                _description,
                MarketplaceAppId: marketplaceAppId,
                PaymentAppId: paymentAppId));

            if (!result.Succeeded)
            {
                Ele.Problem(result.Error!);
                return;
            }

            // "Recorded", never "Saved": beside an amount, saved reads as money put aside.
            var shown = MoneyText.ToDisplayString(amount);
            var about = _kind == TransactionKind.SelfTransfer ? null : _partyName.Trim();
            var id = result.Transaction!.Id;
            var planId = PlanQuery;
            var goalId = _goalId;

            if (planId is { } plan)
            {
                await Planner.CompleteAsync(plan, id);
            }

            string? goalProblem = null;
            if (goalId is { } goal)
            {
                goalProblem = await Goals.AttributeAsync(id, goal);
            }

            // Undo takes the whole thing back: the transaction, and the plan it ticked off.
            Undo.Push(
                UndoHistory.Transactions,
                $"recording {shown}{(about is null ? string.Empty : $" to {about}")}",
                async () =>
                {
                    if (planId is { } p)
                    {
                        await Planner.ReopenAsync(p);
                    }

                    await Editing.DeleteAsync(id);
                },
                async () =>
                {
                    await Editing.RestoreAsync(id, flagForReview: false);
                    if (planId is { } p)
                    {
                        await Planner.CompleteAsync(p, id);
                    }
                });

            if (goalProblem is not null)
            {
                Ele.Problem($"Recorded, but not added to the goal: {goalProblem}");
            }
            else
            {
                Ele.React(EleMoment.Recorded, shown, about);
            }

            // Recorded for a plan or a goal: go back to where the user came from.
            if (planId is not null)
            {
                Leave("plans");
                return;
            }

            if (GoalQuery is not null)
            {
                Leave("plans?tab=goals");
                return;
            }

            _amountText = string.Empty;
            _description = null;

            if (!addAnother)
            {
                _partyName = string.Empty;
                _goalId = null;
            }

            // Usage changed, so the ranking did too.
            await LoadCandidatesAsync();
            await LoadNoteCandidatesAsync();
            _labels = await LabelList.ListByUsageAsync();
        }
        finally
        {
            _busy = false;
        }
    }
    /// <summary>The app's back handling, cascaded from the router.</summary>
    [CascadingParameter]
    public BackNavigator? Back { get; set; }

    // Recorded for a plan or a goal: back to the plan or goal it came from, not forward to a
    // second copy of it, and never back into this form.
    private void Leave(string fallback)
    {
        if (Back is not null)
        {
            Back.Leave(fallback);
            return;
        }

        Nav.NavigateTo(fallback);
    }

    private IReadOnlyList<TypeaheadCandidate> _noteCandidates = [];

    // Note, Bought through and Paid with offer what was used with this contact before ("Gift"
    // for Mom), then what is used most overall. A half-typed or new name is not looked up: it
    // gets the most used straight away.
    private async Task PartyChangedAsync(string name)
    {
        _partyName = name;
        await LoadNoteCandidatesAsync();
    }

    private async Task LoadNoteCandidatesAsync()
    {
        if (_pools is null)
        {
            return;
        }

        var name = _kind == TransactionKind.SelfTransfer ? null : _partyName.Trim();
        var known = name is { Length: > 0 } && _partyCandidates.Any(c => string.Equals(c.Name, name, StringComparison.OrdinalIgnoreCase));
        var lists = await Suggest.ForAsync(_pools, name, known);
        _noteCandidates = lists.Notes;
        _boughtCandidates = lists.BoughtThrough;
        _paidCandidates = lists.PaidWith;
    }
}
