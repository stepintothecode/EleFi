@page "/"
@using EleFi.Application.Abstractions
@using EleFi.Application.Containers
@using EleFi.Domain.Balances
@using EleFi.Domain.Containers
@using EleFi.Domain.Filters
@using EleFi.Domain.Money
@using EleFi.Ui.Services
@implements IDisposable
@inject ContainerService Containers
@inject ITransactionRepository Transactions
@inject PrivacyMode Privacy
@inject TransactionListState ListState
@inject INoticeRepository Notices
@inject IClock Clock
@inject EleFi.Application.Streaks.SteadyLedgerService Streaks
@inject EleFi.Application.Planning.PlanService Planner
@inject EleFi.Application.Goals.GoalService Goals
@inject ISettingsStore Settings
@inject EleReactions Ele
@inject EleGuide Guide

@*
    The dashboard answers one question in three seconds: what do I actually have?

    Net worth is never shown alone. Liquid, Locked, and Owed sit beside it because the
    total on its own hides the situation that matters - most of the wealth untouchable,
    or a card bill about to land.

    Ele is the privacy switch. Tapping it hides every amount in the app, and Ele covers its
    eyes with its ears for as long as they stay hidden.
*@

<RefreshOnResume OnResumed="RefreshAsync" />

<PageTitle>EleFi</PageTitle>

@* The top bar: the streak, and the bell for everything EleFi has done on the user's behalf. *@
<div class="home-top">
    <button type="button" class="streak-chip" aria-label="Steady ledger streak" @onclick="() => _streakOpen = true">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12.6 2.5c.5 3-1 4.6-2.4 6.2C8.7 10.3 7.5 11.8 7.5 14.4A4.6 4.6 0 0 0 12 19c2.6 0 4.6-1.9 4.6-4.6 0-1.6-.6-2.8-1.4-3.9.1 1.3-.4 2.3-1.3 2.8.3-2.8-.4-6.7-1.3-10.8Z" />
        </svg>
        <span>@(_streak is null ? "..." : $"{_streak.Weeks} {(_streak.Weeks == 1 ? "week" : "weeks")}")</span>
    </button>
    <a class="bell" href="notifications" aria-label="@(_unread == 0 ? "Notifications" : $"Notifications, {_unread} unread")">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M6 16.5V11a6 6 0 1 1 12 0v5.5l1.5 2h-15Z" /><path d="M10 20.5a2 2 0 0 0 4 0" />
        </svg>
        @if (_unread > 0)
        {
            <span class="bell-count">@(_unread > 99 ? "99+" : _unread.ToString())</span>
        }
    </a>
</div>

<Modal Open="_streakOpen" Title="Steady ledger" OnCancel="() => _streakOpen = false">
    @* The rule in one line, then where this week stands, then the two numbers that matter.
       Everything else this sheet used to say was explaining the explanation. *@
    <p class="streak-rule">
        A week counts when, by Sunday, every transaction in it is reviewed and every plan due in
        it is done. A quiet week counts too.
    </p>
    @if (_streak is { } streak)
    {
        <div class="streak-now @(streak.ThisWeek.IsTidy ? "tidy" : "untidy")" role="status">
            @if (streak.ThisWeek.IsTidy)
            {
                <strong>This week counts so far.</strong>
            }
            else
            {
                <strong>This week:</strong>
                @if (streak.ThisWeek.ToReview > 0)
                {
                    <span> review @streak.ThisWeek.ToReview @(streak.ThisWeek.ToReview == 1 ? "transaction" : "transactions")</span>
                }
                @if (streak.ThisWeek.ToReview > 0 && streak.ThisWeek.PlansOpen > 0)
                {
                    <span>,</span>
                }
                @if (streak.ThisWeek.PlansOpen > 0)
                {
                    <span> tick off @streak.ThisWeek.PlansOpen @(streak.ThisWeek.PlansOpen == 1 ? "plan" : "plans")</span>
                }
            }
        </div>

        @if (streak.Recent.Count > 0)
        {
            <div class="streak-weeks" aria-label="Recent weeks">
                @foreach (var week in streak.Recent)
                {
                    <span class="streak-week @week.Result.ToString().ToLowerInvariant()"
                          title="Week of @week.Monday.ToString("d MMM"): @WeekText(week.Result)"
                          aria-label="Week of @week.Monday.ToString("d MMM"): @WeekText(week.Result)"></span>
                }
                <span class="streak-week now @(streak.ThisWeek.IsTidy ? "clean" : null)" aria-label="This week"></span>
            </div>
            <div class="streak-legend small muted">
                <span><span class="streak-week clean"></span> counted</span>
                <span><span class="streak-week frozen"></span> saved by a freeze</span>
                <span><span class="streak-week missed"></span> missed</span>
            </div>
        }

        <div class="streak-facts">
            <div class="row between">
                <span>Freezes</span>
                <strong>@streak.Freezes</strong>
            </div>
            <p class="muted small">One earned every 4 counted weeks. It saves a missed week on its own.</p>
            @if (streak.NextMilestone is { } next)
            {
                <div class="row between">
                    <span>Next milestone</span>
                    <strong>@next weeks</strong>
                </div>
            }
        </div>
    }
    <button class="primary btn-block" @onclick="() => _streakOpen = false">Got it</button>
</Modal>

<div class="row between">
    <div>
        <div class="muted small">Net worth</div>
        @if (_loading)
        {
            <div class="skeleton" style="width: 180px; height: 34px; margin: 6px 0;"></div>
        }
        else
        {
            <div class="headline">@Format(_netWorth.Total)</div>
        }
    </div>
    <button type="button" class="mascot-toggle"
            aria-pressed="@(Privacy.AmountsHidden ? "true" : "false")"
            aria-label="@(Privacy.AmountsHidden ? "Show amounts" : "Hide amounts")"
            @onclick="Privacy.Toggle">
        <MascotViewer Mood="@(Privacy.AmountsHidden ? MascotMood.Hiding : _mood)" />
    </button>
</div>

@*
    Guarded on _loading like everything else. These tiles used to render on the very first
    pass, before OnInitializedAsync had run, formatting a default(NetWorth) whose currency
    was unset. That threw and took the whole app down with "An unhandled error has
    occurred". Money is now safe to format in that state, and the tiles wait anyway: a
    skeleton is honest, a flash of zero is not.
*@
<div class="tiles enter">
    <button type="button" class="tile" aria-label="Liquid: what makes it up" disabled="@_loading" @onclick="() => _part = NetWorthPart.Liquid">
        <span class="label">Liquid</span>
        <span class="value">@(_loading ? "..." : Format(_netWorth.Liquid))</span>
    </button>
    <button type="button" class="tile" aria-label="Locked: what makes it up" disabled="@_loading" @onclick="() => _part = NetWorthPart.Locked">
        <span class="label">Locked</span>
        <span class="value">@(_loading ? "..." : Format(_netWorth.Locked))</span>
    </button>
    <button type="button" class="tile" aria-label="Owed: what makes it up" disabled="@_loading" @onclick="() => _part = NetWorthPart.Owed">
        <span class="label">Owed</span>
        <span class="value @(!_loading && _netWorth.Owed.Minor > 0 ? "owed amount" : string.Empty)">
            @(_loading ? "..." : Format(_netWorth.Owed))
        </span>
    </button>
</div>

@* What a figure is made of, from the same rule that adds it up. *@
<Modal Open="_part is not null" Title="@PartTitle" OnCancel="() => _part = null">
    @if (_part is { } part)
    {
        var rows = _balances.Where(b => BalanceMath.PartOf(b) == part).ToList();
        <p class="muted small">@PartHelp(part)</p>
        @if (rows.Count == 0)
        {
            <p class="small">No container counts toward this yet.</p>
        }
        else
        {
            <div class="card flat">
                @foreach (var balance in rows)
                {
                    <div class="txn">
                        <div class="grow">
                            <div class="who">@balance.Name</div>
                            @if (balance.Detail is { } detail)
                            {
                                <div class="detail">@detail</div>
                            }
                            <div class="meta">@balance.Kind.DisplayName()</div>
                        </div>
                        <div class="amount @(part == NetWorthPart.Owed && balance.AmountOwed.Minor > 0 ? "owed" : null)">
                            @Format(part == NetWorthPart.Owed ? balance.AmountOwed : balance.Balance)
                        </div>
                    </div>
                }
            </div>
        }
        <a class="btn btn-ghost btn-block" href="containers">All containers</a>
    }
</Modal>

@if (!_loading && _balances.Count == 0)
{
    <div class="card muted">
        No containers yet. Add the bank account or wallet you use most and give it the balance it has today.
        <a class="btn btn-primary btn-block" href="containers" style="margin-top: 12px;">Add a container</a>
    </div>
}

@* Recorded from an SMS or a payment app, or captured quickly: real, counted, and worth a
   look. One tap opens the list filtered to just those. *@
@if (_needsReview > 0)
{
    <a class="inbox-banner enter" href="transactions" @onclick="ShowNeedsReview">
        <span class="count">@_needsReview</span>
        <span>
            <strong>@(_needsReview == 1 ? "1 transaction needs" : $"{_needsReview} transactions need") review</strong>
            <span class="meta" style="display:block;">Recorded from a message or captured quickly.</span>
        </span>
        <span class="chev" aria-hidden="true">&rsaquo;</span>
    </a>
}

@* Tabs rather than a heading, so today, last month and any other stretch are one tap away.
   This month stays the one shown first. *@
<div class="segmented" role="tablist" aria-label="Period">
    <button type="button" role="tab" class="@(_period == DatePreset.Today ? "on" : null)"
            aria-selected="@(_period == DatePreset.Today ? "true" : "false")"
            @onclick="() => ShowPresetAsync(DatePreset.Today)">Today</button>
    <button type="button" role="tab" class="@(_period == DatePreset.ThisMonth ? "on" : null)"
            aria-selected="@(_period == DatePreset.ThisMonth ? "true" : "false")"
            @onclick="() => ShowPresetAsync(DatePreset.ThisMonth)">This month</button>
    <button type="button" role="tab" class="@(_period == DatePreset.LastMonth ? "on" : null)"
            aria-selected="@(_period == DatePreset.LastMonth ? "true" : "false")"
            @onclick="() => ShowPresetAsync(DatePreset.LastMonth)">Last month</button>
    <button type="button" role="tab" class="@(_period == DatePreset.Custom ? "on" : null)"
            aria-selected="@(_period == DatePreset.Custom ? "true" : "false")"
            @onclick="() => _rangeOpen = true">@(_period == DatePreset.Custom ? RangeText : "Range")</button>
</div>

<DateRangeSheet Open="_rangeOpen" Initial="_range" OnApply="ShowRangeAsync" OnCancel="() => _rangeOpen = false" />

@if (_loading)
{
    <div class="card"><div class="skeleton" style="width: 60%;"></div></div>
}
else if (_spend.ByLabel.Count == 0)
{
    <div class="card muted">
        Nothing spent in this period.
        <a class="btn btn-ghost" href="capture" style="margin-top: 10px;">Record something</a>
    </div>
}
else
{
    <div class="card">
        @* The total comes from the breakdown's own TotalMinor, counted once per
           transaction. Summing the rows below would be larger, because a transaction with
           two labels appears in full under both. *@
        <div class="row between" style="margin-bottom: 10px;">
            <span class="muted small">Spent</span>
            <span class="amount out">@Format(Money.SignedMinor(_spend.TotalMinor, _home))</span>
        </div>

        @foreach (var row in _spend.ByLabel)
        {
            @* Bars are scaled against the largest label, not against the total. A share of
               the total would be a lie: the parts overlap and can exceed the whole. *@
            var share = _largestLabel == 0 ? 0 : (int)(row.AmountMinor * 100 / _largestLabel);
            <div style="margin-bottom: 10px;">
                <div class="row between small">
                    <span>@row.LabelName</span>
                    <span class="amount">@Format(Money.SignedMinor(row.AmountMinor, _home))</span>
                </div>
                <div class="bar" style="width: @(share)%; background: @(row.Colour ?? "var(--ele-accent)");"></div>
            </div>
        }

        @* Only when the bars genuinely exceed the total. Two labels on two different
           transactions do not overlap, and explaining a discrepancy that is not on screen
           teaches the reader to distrust a total that was right all along. *@
        @if (_labelsOverlap)
        {
            <p class="muted small" style="margin: 12px 0 0;">
                A transaction with several labels is counted under each, so these add up to
                more than the total above.
            </p>
        }
    </div>
}

@* What is still to come this month: bills not paid yet, money not arrived yet. *@
@if (_planned is { Count: > 0 } planned)
{
    <a class="card still-planned" href="plans">
        <span class="row between">
            <span class="who">Still planned this month</span>
            <span class="chev" aria-hidden="true">&rsaquo;</span>
        </span>
        <span class="meta">
            @if (planned.OutMinor > 0)
            {
                <span><span class="amount out">@Format(Money.SignedMinor(planned.OutMinor, _home))</span> to pay</span>
            }
            @if (planned.OutMinor > 0 && planned.InMinor > 0)
            {
                <span> &middot; </span>
            }
            @if (planned.InMinor > 0)
            {
                <span><span class="amount in">@Format(Money.SignedMinor(planned.InMinor, _home))</span> to come in</span>
            }
            <span> &middot; @planned.Count @(planned.Count == 1 ? "plan" : "plans")</span>
        </span>
    </a>
}

@if (_goals.Count > 0)
{
    <div class="section-head">
        <h2>Goals</h2>
        <a class="btn-ghost small" href="plans?tab=goals">All goals</a>
    </div>
    <div class="card">
        @foreach (var view in _goals)
        {
            <a class="home-goal" href="plans?tab=goals">
                <span class="row between small">
                    <span class="who">@view.Goal.Name</span>
                    <span>@view.Standing.Percent%</span>
                </span>
                <span class="goal-bar" role="progressbar" aria-label="@view.Goal.Name progress"
                      aria-valuemin="0" aria-valuemax="100" aria-valuenow="@view.Standing.Percent">
                    <span class="goal-fill @GoalClass(view.Standing.Status)" style="width:@(view.Standing.Percent)%;"></span>
                </span>
                @if (view.ProjectedFinish is { } finish && view.Standing.Status != EleFi.Domain.Goals.GoalStatus.Achieved)
                {
                    <span class="meta">At this pace, done by @finish.ToString("MMM yyyy")</span>
                }
            </a>
        }
    </div>
}
@code {
    private bool _loading = true;
    private NetWorth _netWorth;
    private IReadOnlyList<ContainerBalance> _balances = [];
    private SpendBreakdown _spend;
    private long _largestLabel;
    private bool _labelsOverlap;
    private Currency _home = Currency.Inr;
    private MascotMood _mood = MascotMood.Idle;
    private int _needsReview;
    private int _unread;
    private bool _streakOpen;
    private EleFi.Domain.Streaks.SteadyStreak? _streak;
    private NetWorthPart? _part;
    private EleFi.Application.Planning.PlannedTotals? _planned;
    private IReadOnlyList<EleFi.Application.Goals.GoalView> _goals = [];

    // The streak Ele last celebrated, so a milestone is cheered once, not on every visit.
    private const string CelebratedKey = "streak.celebrated";

    private const int GoalsShown = 3;

    private string PartTitle => _part switch
    {
        NetWorthPart.Liquid => $"Liquid: {Format(_netWorth.Liquid)}",
        NetWorthPart.Locked => $"Locked: {Format(_netWorth.Locked)}",
        NetWorthPart.Owed => $"Owed: {Format(_netWorth.Owed)}",
        _ => string.Empty,
    };

    private static string PartHelp(NetWorthPart part) => part switch
    {
        NetWorthPart.Liquid => "Money you can spend this week: bank accounts, cash and wallets.",
        NetWorthPart.Locked => "Real wealth you cannot spend on demand: deposits, PPF and investments, at what you put in.",
        _ => "What your credit cards owe. A card paid ahead shows as a negative amount here.",
    };

    private static string WeekText(EleFi.Domain.Streaks.WeekResult result) => result switch
    {
        EleFi.Domain.Streaks.WeekResult.Clean => "clean",
        EleFi.Domain.Streaks.WeekResult.Frozen => "kept by a freeze",
        _ => "missed",
    };

    private static string GoalClass(EleFi.Domain.Goals.GoalStatus status) => status switch
    {
        EleFi.Domain.Goals.GoalStatus.Achieved => "achieved",
        EleFi.Domain.Goals.GoalStatus.OnTrack => "on-track",
        _ => "behind",
    };

    private DatePreset _period = DatePreset.ThisMonth;
    private TransactionFilter _range = TransactionFilter.Empty;
    private bool _rangeOpen;

    // Short enough for a quarter of a phone's width: "10-12 Aug", or "28 Aug-2 Sep" across
    // months. The times chosen still apply; the sheet shows them.
    private string RangeText => _range.From is { } from && _range.To is { } to
        ? from.Month == to.Month && from.Year == to.Year
            ? from == to ? $"{from:d MMM}" : $"{from:%d}-{to:d MMM}"
            : $"{from:d MMM}-{to:d MMM}"
        : "Range";

    protected override async Task OnInitializedAsync()
    {
        Privacy.Changed += OnPrivacyChanged;

        _range = TransactionFilter.Empty.WithPreset(_period, Clock.Today);
        await RefreshAsync();

        // A new user, with nothing set up: Ele walks them through, once.
        if (Guide.ShouldStartOnItsOwn(hasContainers: _balances.Count > 0))
        {
            Guide.Start();
        }

        _loading = false;
    }

    // Everything the dashboard shows, read again: on opening, and when the app comes back to
    // the front. The chosen period and anything open stay as they are.
    private async Task RefreshAsync()
    {
        // Already in picker order: cards, banks, cash and wallets, the rest.
        _balances = await Containers.BalancesAsync();
        _netWorth = await Containers.NetWorthAsync(_home);
        _needsReview = await Transactions.CountAsync(new TransactionFilter { NeedsReview = true });
        _unread = await Notices.UnreadCountAsync();

        // "Today" and "This month" move with the clock; a chosen range stays what was chosen.
        if (_period != DatePreset.Custom)
        {
            _range = TransactionFilter.Empty.WithPreset(_period, Clock.Today);
        }

        await LoadSpendAsync();

        _streak = await Streaks.CurrentAsync();
        _planned = await Planner.StillPlannedAsync();
        _goals = [.. (await Goals.OverviewAsync()).Where(v => !v.Goal.IsArchived).Take(GoalsShown)];

        // The mascot reacts, but nothing waits on it (NFR-2.7).
        _mood = _netWorth.Owed.Minor > _netWorth.Liquid.Minor ? MascotMood.Concerned : MascotMood.Idle;
        CelebrateMilestone();
    }

    public void Dispose() => Privacy.Changed -= OnPrivacyChanged;

    private void CelebrateMilestone()
    {
        if (_streak?.MilestoneReached is not { } weeks)
        {
            return;
        }

        var key = weeks.ToString(System.Globalization.CultureInfo.InvariantCulture);
        if (Settings.Read(CelebratedKey, string.Empty) == key)
        {
            return;
        }

        Settings.Write(CelebratedKey, key);
        _mood = MascotMood.Happy;
        Ele.Say($"{weeks} steady weeks in a row. Your ledger is true, and that is a real habit.");
    }

    private void OnPrivacyChanged() => InvokeAsync(StateHasChanged);

    // Set on the list's state rather than passed as a query string. A query in the URL is
    // replayed whenever back returns to it, which would wipe any filtering done since.
    private void ShowNeedsReview()
    {
        ListState.Filter = TransactionFilter.Empty with { NeedsReview = true };
        ListState.Preset = DatePreset.AllTime;
        ListState.Loaded = 0;
        ListState.ReturnTo = null;
    }

    private async Task ShowPresetAsync(DatePreset preset)
    {
        _period = preset;
        _range = TransactionFilter.Empty.WithPreset(preset, Clock.Today);
        await LoadSpendAsync();
    }

    private async Task ShowRangeAsync(TransactionFilter range)
    {
        _rangeOpen = false;
        _period = DatePreset.Custom;
        _range = range;
        await LoadSpendAsync();
    }

    private async Task LoadSpendAsync()
    {
        _spend = await Transactions.SpendByLabelAsync(_range);
        _largestLabel = _spend.ByLabel.Count == 0 ? 0 : _spend.ByLabel.Max(s => s.AmountMinor);

        // Computed once, not per bar. The buckets exceed the total exactly when some
        // transaction carries more than one label, which is the only case worth a note.
        _labelsOverlap = _spend.ByLabel.Sum(s => s.AmountMinor) > _spend.TotalMinor;
    }

    private static string Format(Money amount) => MoneyText.ToDisplayString(amount);
}
