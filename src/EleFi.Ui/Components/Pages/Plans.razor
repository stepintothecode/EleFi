@page "/plans"
@using EleFi.Application.Abstractions
@using EleFi.Application.Planning
@using EleFi.Application.Transactions
@using EleFi.Application.Typeahead
@using EleFi.Domain.Audit
@using EleFi.Domain.Labels
@using EleFi.Domain.Containers
@using EleFi.Domain.Money
@using EleFi.Domain.Planning
@using EleFi.Domain.Transactions
@using EleFi.Ui.Services
@inject PlanService Planner
@inject IContainerRepository Containers
@inject IPartyRepository Parties
@inject EleReactions Ele
@inject UndoHistory Undo
@inject EleFi.Application.Labels.LabelService LabelList
@inject IAlertAccess Access
@inject NavigationManager Nav
@inject IClock Clock

@*
    Plans and goals: what is coming, and what it is all for.

    A plan is money the user expects to move, shaped like a to-do item: a circle to tick on
    the left, grouped by when it is due, done ones collapsed under Completed. Ticking one off
    links it to the transaction that already records it, or records that transaction, so the
    same money is never in the ledger twice. A plan on its own is never money (D2).

    Goals sit beside them on the same page (GoalsPanel): what the money is for.
*@

<PageTitle>Plans</PageTitle>

<RefreshOnResume OnResumed="RefreshAsync" />

<div class="section-head">
    <h1>Plans</h1>
    @if (_tab == "plans")
    {
        <span class="row" style="gap:4px;">
            <UndoRedo Area="@UndoHistory.Plans" OnChanged="ReloadAsync" />
            <button class="primary" @onclick="StartCreate">New plan</button>
        </span>
    }
    else
    {
        @* The same place as on Plans: the arrows sit in the page's top bar, beside New. *@
        <span class="row" style="gap:4px;">
            <UndoRedo Area="@UndoHistory.Goals" OnChanged="ReloadGoalsAsync" />
            <button class="primary" id="new-goal" @onclick="() => _goalsPanel?.StartCreate()">New goal</button>
        </span>
    }
</div>

<div class="segmented" role="tablist" aria-label="Plans or goals" style="margin-top:0;">
    <button type="button" role="tab" class="@(_tab == "plans" ? "on" : null)" aria-selected="@(_tab == "plans" ? "true" : "false")"
            @onclick='() => ShowTab("plans")'>Plans</button>
    <button type="button" role="tab" class="@(_tab == "goals" ? "on" : null)" aria-selected="@(_tab == "goals" ? "true" : "false")"
            @onclick='() => ShowTab("goals")'>Goals</button>
</div>

@if (_tab == "goals")
{
    <GoalsPanel @ref="_goalsPanel" />
}
else if (_loading)
{
    <div class="card"><div class="skeleton" style="width:60%;"></div></div>
}
else
{
    @if (_open.Count == 0)
    {
        <div class="card empty-state">
            <svg class="empty-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="4" y="5" width="16" height="15" rx="2.5" /><path d="M8 3v4M16 3v4M4 10h16M9 14.5l2 2 4-4" />
            </svg>
            <div class="who">Nothing planned</div>
            <p class="muted small">Add the money you know is coming: a SIP, the rent, the card bill, paying someone back.</p>
        </div>
    }

    @foreach (var group in _open.GroupBy(p => p.BucketOn(Clock.Today)).OrderBy(g => g.Key))
    {
        <h2 class="plan-group @(group.Key == PlanBucket.Overdue ? "overdue" : null)">@BucketName(group.Key)</h2>
        <div class="card plan-list">
            @foreach (var plan in group)
            {
                <div class="plan-row" @key="plan.Id">
                    <button type="button" class="plan-tick" aria-label="Mark @plan.Title done" @onclick="() => TickAsync(plan)">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9" /></svg>
                    </button>
                    <button type="button" class="plan-body" @onclick="() => StartEdit(plan)">
                        <span class="who">@plan.Title</span>
                        <span class="meta">@Describe(plan)</span>
                    </button>
                    @if (plan.AmountMinor is { } minor)
                    {
                        <span class="amount @(plan.Direction == TransactionKind.Credit ? "in" : plan.Direction == TransactionKind.SelfTransfer ? "transfer" : "out")">
                            @MoneyText.ToDisplayString(Money.FromMinor(minor, Currency.Of(plan.CurrencyCode)))
                        </span>
                    }
                </div>
            }
        </div>
    }

    @if (_completed.Count > 0)
    {
        <details class="completed">
            <summary>Completed (@_completed.Count)</summary>
            <div class="card plan-list">
                @foreach (var plan in _completed)
                {
                    <div class="plan-row done" @key="plan.Id">
                        <button type="button" class="plan-tick on" aria-label="Mark @plan.Title not done" @onclick="() => ReopenAsync(plan)">
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <circle cx="12" cy="12" r="10" fill="currentColor" />
                                <path d="M7.5 12.5l3 3 6-6.5" fill="none" stroke="var(--ele-on-primary)" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                        </button>
                        <div class="plan-body">
                            <span class="who">@plan.Title</span>
                            <span class="meta">
                                @(plan.IsSkipped ? "Skipped" : "Done") @plan.CompletedAt?.ToLocalTime().ToString("d MMM")
                                @(plan.IsSkipped ? string.Empty : plan.TransactionId is null ? " · no transaction" : " · linked")
                            </span>
                        </div>
                        @if (plan.TransactionId is { } linked)
                        {
                            <a class="btn btn-ghost btn-icon" href="transactions/@linked">Open</a>
                        }
                    </div>
                }
            </div>
        </details>
    }
}

@* The plan form, in a sheet. *@
<Modal Open="_editing" Title="@(_editingId is null ? "New plan" : "Edit plan")" OnCancel="() => _editing = false">
    <div class="field">
        <label for="plan-title">What is it?</label>
        <input id="plan-title" @bind="_title" placeholder="SIP, Axis Bluechip" autocomplete="off" />
    </div>

    <div class="chips" role="group" aria-label="Kind" style="margin-bottom:12px;">
        <button type="button" class="chip @(_direction == TransactionKind.Debit ? "on" : null)" @onclick="() => _direction = TransactionKind.Debit">Pay</button>
        <button type="button" class="chip @(_direction == TransactionKind.Credit ? "on" : null)" @onclick="() => _direction = TransactionKind.Credit">Receive</button>
        <button type="button" class="chip @(_direction == TransactionKind.SelfTransfer ? "on" : null)" @onclick="() => _direction = TransactionKind.SelfTransfer">Move between mine</button>
    </div>

    <div class="field">
        <label for="plan-amount">Amount <span class="muted small">(optional)</span></label>
        <input id="plan-amount" class="amount-input" type="text" inputmode="decimal" @bind="_amountText" placeholder="0.00" autocomplete="off" />
    </div>

    <div class="field">
        <label for="plan-from">@ContainerLabel <span class="muted small">(optional)</span></label>
        <ContainerSelect Id="plan-from" Title="@ContainerLabel" Containers="_containers"
                         Placeholder="Any container" Value="_containerId" ValueChanged="id => _containerId = id" />
    </div>

    @if (_direction == TransactionKind.SelfTransfer)
    {
        <div class="field">
            <label for="plan-to">Destination container</label>
            <ContainerSelect Id="plan-to" Title="Destination container" Containers="_containers" Placeholder="Choose one"
                             Value="_destinationId" ValueChanged="id => _destinationId = id" />
        </div>
    }
    else
    {
        <div class="field">
            <label for="plan-who">@(_direction == TransactionKind.Credit ? "Received from" : "Paid to") <span class="muted small">(optional)</span></label>
            <TypeaheadInput Id="plan-who" Value="@_who" ValueChanged="v => _who = v" Candidates="_partyCandidates" IdleCount="0" />
        </div>

        <div class="field">
            <label>Labels <span class="muted small">(optional, carried into the transaction)</span></label>
            <LabelPicker Labels="_labels" Selected="_labelIds" SelectedChanged="ids => _labelIds = ids" />
        </div>
    }

    <div class="row">
        <div class="field grow">
            <label for="plan-due">Due</label>
            <input id="plan-due" type="date" @bind="_due" />
        </div>
        <div class="field grow">
            <label for="plan-time">At <span class="muted small">(optional)</span></label>
            <input id="plan-time" type="time" @bind="_dueTime" />
        </div>
    </div>

    <div class="field">
        <label for="plan-repeat">Repeat</label>
        <select id="plan-repeat" @bind="_frequency">
            <option value="@RepeatFrequency.None">Never</option>
            <option value="@RepeatFrequency.Daily">Daily</option>
            <option value="@RepeatFrequency.Weekly">Weekly</option>
            <option value="@RepeatFrequency.Monthly">Monthly</option>
            <option value="@RepeatFrequency.Yearly">Yearly</option>
        </select>
    </div>

    @if (_frequency != RepeatFrequency.None)
    {
        <div class="field">
            <label for="plan-every">Every</label>
            <div class="row">
                <input id="plan-every" type="number" min="1" max="99" inputmode="numeric" @bind="_interval" style="width:90px;" />
                <span class="muted small">@DraftRule.Describe(_lastDay ? RepeatRule.LastDay : _due.Day).ToLowerInvariant()</span>
            </div>
        </div>

        @if (_frequency == RepeatFrequency.Weekly)
        {
            <div class="field">
                <label>On <span class="muted small">(none chosen means the due date's day)</span></label>
                <div class="chips weekday-chips" role="group" aria-label="Days of the week">
                    @foreach (var (day, name) in WeekDays)
                    {
                        var on = (_days & day) != 0;
                        <button type="button" class="chip @(on ? "on" : null)" aria-pressed="@(on ? "true" : "false")"
                                @onclick="() => _days ^= day">@name</button>
                    }
                </div>
            </div>
        }

        @if (_frequency == RepeatFrequency.Monthly)
        {
            <label class="check-row">
                <input type="checkbox" id="plan-last-day" checked="@_lastDay" @onchange="e => _lastDay = e.Value is true" />
                <span class="small">On the last day of every month</span>
            </label>
        }

        <div class="field">
            <label for="plan-ends">Ends</label>
            <select id="plan-ends" @bind="_ends">
                <option value="never">Never</option>
                <option value="date">On a date</option>
                <option value="count">After a number of times</option>
            </select>
        </div>

        @if (_ends == "date")
        {
            <div class="field">
                <label for="plan-until">Last one on or before</label>
                <input id="plan-until" type="date" @bind="_until" />
            </div>
        }
        else if (_ends == "count")
        {
            <div class="field">
                <label for="plan-count">How many times in all</label>
                <input id="plan-count" type="number" min="1" max="999" inputmode="numeric" @bind="_count" style="width:110px;" />
            </div>
        }
    }

    <div class="field">
        <label for="plan-note">Note <span class="muted small">(optional)</span></label>
        <input id="plan-note" @bind="_note" autocomplete="off" />
    </div>

    <p class="muted small">A reminder comes on the due day, at the time set or at 9:00, with Mark done and Snooze to tomorrow.</p>

    <button class="primary btn-block" disabled="@_busy" @onclick="SaveAsync">Save</button>
    @if (_editingId is { } editing && _open.FirstOrDefault(p => p.Id == editing) is { } current)
    {
        <div class="row" style="margin-top:8px;">
            <button class="btn-ghost grow skip-plan" disabled="@_busy" @onclick="() => SkipAsync(current)">Skip this one</button>
            <button class="btn-ghost danger grow" disabled="@_busy" @onclick="() => DeleteAsync(editing)">Delete plan</button>
        </div>

        @if (_history.Count > 0)
        {
            <details class="plan-history">
                <summary>History (@_history.Count)</summary>
                @foreach (var entry in _history)
                {
                    <div class="timeline-entry">
                        <div class="row between">
                            <strong>@ActionLabel(entry.Action)</strong>
                            <span class="meta">@entry.OccurredAt.ToLocalTime().ToString("d MMM yyyy, HH:mm")</span>
                        </div>
                        @if (entry.Changes.Count > 0)
                        {
                            <ul class="timeline-changes">
                                @foreach (var change in entry.Changes)
                                {
                                    <li>
                                        <span class="meta">@change.Field</span>
                                        <span class="was">@change.From</span>
                                        <span aria-hidden="true">&rarr;</span>
                                        <span class="now">@change.To</span>
                                    </li>
                                }
                            </ul>
                        }
                    </div>
                }
            </details>
        }
    }
</Modal>
@* Ticking off a plan with an amount: link what is already there, or record it. *@
<Modal Open="_ticking is not null" Title="@($"Mark {_ticking?.Title} done")" OnCancel="() => _ticking = null">
    @if (_ticking is { } plan)
    {
        @if (_candidates.Count > 0)
        {
            <div class="typeahead-caption">
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2.5l1.9 5.6 5.6 1.9-5.6 1.9L12 17.5l-1.9-5.6L4.5 10l5.6-1.9z" /><path d="M18.5 15l.8 2.2 2.2.8-2.2.8-.8 2.2-.8-2.2-2.2-.8 2.2-.8z" /></svg>
                Suggestions
            </div>
            <p class="muted small">Already in your transactions. Pick the one that is this plan.</p>
            <div class="picker-list">
                @foreach (var candidate in _candidates)
                {
                    <button type="button" class="picker-option suggestion" @onclick="() => LinkAsync(plan, candidate.Id)">
                        <span class="picker-text">
                            <span class="picker-name">@Who(candidate)</span>
                            <span class="detail">@candidate.OccurredOn.ToString("ddd d MMM")</span>
                        </span>
                        <span class="amount">@MoneyText.ToDisplayString(candidate.SourceAmount)</span>
                    </button>
                }
            </div>
        }
        else
        {
            <p class="muted small">No transaction like this is in the ledger yet, so nothing was recorded for it.</p>
        }

        <div class="stack" style="margin-top:12px;">
            <button class="primary btn-block" @onclick="() => RecordNow(plan)">Record it now</button>
            <button class="btn-ghost btn-block" @onclick="() => LinkAsync(plan, null)">Done, no transaction</button>
            <button class="btn-ghost btn-block skip-plan" @onclick="() => SkipAsync(plan)">Skip this one</button>
        </div>
    }
</Modal>

@code {
    private static readonly (RepeatDays Day, string Name)[] WeekDays =
    [
        (RepeatDays.Monday, "Mon"), (RepeatDays.Tuesday, "Tue"), (RepeatDays.Wednesday, "Wed"),
        (RepeatDays.Thursday, "Thu"), (RepeatDays.Friday, "Fri"), (RepeatDays.Saturday, "Sat"),
        (RepeatDays.Sunday, "Sun"),
    ];

    private string _tab = "plans";

    /// <summary>The app's back handling, cascaded from the router.</summary>
    [CascadingParameter]
    public BackNavigator? Back { get; set; }

    // The tab is in the address, in place, so coming back to this page (from recording money
    // toward a goal, say) lands on the tab that was open, without a history step per switch.
    private void ShowTab(string tab)
    {
        _tab = tab;
        Back?.ReplaceTo(tab == "goals" ? "plans?tab=goals" : "plans");
    }
    private GoalsPanel? _goalsPanel;

    /// <summary>Which half to open on: "goals" or "plans".</summary>
    [SupplyParameterFromQuery(Name = "tab")]
    public string? TabQuery { get; set; }

    /// <summary>A plan to tick off on arrival, from a reminder's Mark done.</summary>
    [SupplyParameterFromQuery(Name = "tick")]
    public Guid? TickQuery { get; set; }

    private IReadOnlyList<Plan> _open = [];
    private IReadOnlyList<Plan> _completed = [];
    private IReadOnlyList<Container> _containers = [];
    private IReadOnlyList<Label> _labels = [];
    private IReadOnlyList<TypeaheadCandidate> _partyCandidates = [];
    private bool _loading = true;
    private bool _busy;

    private bool _editing;
    private Guid? _editingId;
    private string _title = string.Empty;
    private TransactionKind _direction = TransactionKind.Debit;
    private string _amountText = string.Empty;
    private Guid _containerId;
    private Guid _destinationId;
    private string _who = string.Empty;
    private DateTime _due = DateTime.Today;
    private TimeOnly? _dueTime;
    private RepeatFrequency _frequency = RepeatFrequency.None;
    private int _interval = 1;
    private RepeatDays _days;
    private bool _lastDay;
    private string _ends = "never";
    private DateTime _until = DateTime.Today;
    private int _count = 12;
    private IReadOnlyList<Guid> _labelIds = [];
    private string? _note;
    private IReadOnlyList<HistoryEntry> _history = [];

    private Plan? _ticking;
    private IReadOnlyList<Transaction> _candidates = [];

    private RepeatRule DraftRule => new(
        _frequency,
        Math.Max(1, _interval),
        _frequency == RepeatFrequency.Weekly ? _days : RepeatDays.None);

    protected override async Task OnInitializedAsync()
    {
        if (TabQuery == "goals")
        {
            _tab = "goals";
        }

        _containers = ContainerGrouping.InPickerOrder(await Containers.ListSelectableAsync());
        _partyCandidates = TypeaheadCandidates.From(await Parties.ListExternalAsync());
        _labels = await LabelList.ListByUsageAsync();
        await ReloadAsync();
        _loading = false;

        // Mark done on a reminder lands here with the plan to tick.
        if (TickQuery is { } tick && _open.FirstOrDefault(p => p.Id == tick) is { } plan)
        {
            await TickAsync(plan);
        }
    }

    // Back from the background: both halves read again, whichever tab is open.
    private async Task RefreshAsync()
    {
        await ReloadAsync();
        await ReloadGoalsAsync();
    }

    private async Task ReloadGoalsAsync()
    {
        if (_goalsPanel is not null)
        {
            await _goalsPanel.ReloadAsync();
        }
    }

    private async Task ReloadAsync()
    {
        _open = await Planner.OpenAsync();
        _completed = await Planner.CompletedAsync();
    }

    private static string BucketName(PlanBucket bucket) => bucket switch
    {
        PlanBucket.Overdue => "Overdue",
        PlanBucket.Today => "Today",
        PlanBucket.ThisWeek => "This week",
        _ => "Later",
    };

    private static string ActionLabel(AuditAction action) => action switch
    {
        AuditAction.Created => "Planned",
        AuditAction.Updated => "Changed",
        AuditAction.Deleted => "Deleted",
        AuditAction.Restored => "Restored",
        _ => action.ToString(),
    };

    private string Describe(Plan plan)
    {
        var parts = new List<string>
        {
            plan.DueOn == Clock.Today ? "Today" : plan.DueOn.ToString("ddd d MMM"),
        };

        if (plan.DueTime is { } time)
        {
            parts[0] += $" {time:HH\\:mm}";
        }

        if (plan.Repeat.Repeats)
        {
            var repeat = "↻ " + plan.Repeat.Describe(plan.AnchorDay);
            if (plan.RepeatCount is { } count)
            {
                repeat += $", {plan.Occurrence} of {count}";
            }
            else if (plan.RepeatUntil is { } until)
            {
                repeat += $", until {until:d MMM yyyy}";
            }

            parts.Add(repeat);
        }

        if (plan.ContainerId is { } id && _containers.FirstOrDefault(c => c.Id == id) is { } container)
        {
            parts.Add(container.Name);
        }

        if (plan.RemindOn is { } remind && remind > Clock.Today)
        {
            parts.Add($"reminder {remind:ddd d MMM}");
        }

        return string.Join(" · ", parts);
    }

    private static string Who(Transaction t) => t.Kind switch
    {
        TransactionKind.Credit => t.SourceParty?.Name ?? "Received",
        TransactionKind.Debit => t.DestinationParty?.Name ?? "Paid",
        _ => "Transfer",
    };

    private void StartCreate()
    {
        _editingId = null;
        _title = string.Empty;
        _direction = TransactionKind.Debit;
        _amountText = string.Empty;
        _containerId = Guid.Empty;
        _destinationId = Guid.Empty;
        _who = string.Empty;
        _due = Clock.Today.ToDateTime(TimeOnly.MinValue);
        _dueTime = null;
        _frequency = RepeatFrequency.None;
        _interval = 1;
        _days = RepeatDays.None;
        _lastDay = false;
        _ends = "never";
        _until = Clock.Today.AddYears(1).ToDateTime(TimeOnly.MinValue);
        _count = 12;
        _labelIds = [];
        _note = null;
        _history = [];
        _editing = true;
    }

    private async Task StartEdit(Plan plan)
    {
        _editingId = plan.Id;
        _title = plan.Title;
        _direction = plan.Direction;
        _amountText = plan.AmountMinor is { } minor ? MoneyText.ToBareDecimal(Money.FromMinor(minor, Currency.Of(plan.CurrencyCode))) : string.Empty;
        _containerId = plan.ContainerId ?? Guid.Empty;
        _destinationId = plan.DestinationContainerId ?? Guid.Empty;
        _who = plan.CounterpartyName ?? string.Empty;
        _due = plan.DueOn.ToDateTime(TimeOnly.MinValue);
        _dueTime = plan.DueTime;
        _frequency = plan.RepeatFrequency;
        _interval = plan.RepeatInterval;
        _days = plan.RepeatDays;
        _lastDay = plan.RepeatFrequency == RepeatFrequency.Monthly && plan.AnchorDay >= RepeatRule.LastDay;
        _ends = plan.RepeatCount is not null ? "count" : plan.RepeatUntil is not null ? "date" : "never";
        _until = (plan.RepeatUntil ?? Clock.Today.AddYears(1)).ToDateTime(TimeOnly.MinValue);
        _count = plan.RepeatCount ?? 12;
        _labelIds = [.. plan.Labels.Select(l => l.LabelId)];
        _note = plan.Note;
        _editing = true;

        var names = _containers.ToDictionary(c => c.Id, c => c.Name);
        _history = await Planner.HistoryAsync(plan.Id, names);
    }

    private async Task SaveAsync()
    {
        long? amount = null;
        if (!string.IsNullOrWhiteSpace(_amountText))
        {
            if (!MoneyText.TryParse(_amountText, Currency.Inr, out var parsed) || parsed.Minor <= 0)
            {
                Ele.Problem("The amount must be a number more than zero, or left empty.");
                return;
            }

            amount = parsed.Minor;
        }

        var repeats = _frequency != RepeatFrequency.None;
        var draft = new PlanDraft(
            _title,
            DateOnly.FromDateTime(_due),
            amount,
            _direction,
            _containerId == Guid.Empty ? null : _containerId,
            _who,
            _destinationId == Guid.Empty ? null : _destinationId,
            DraftRule,
            _dueTime,
            _note,
            LastDayOfMonth: repeats && _frequency == RepeatFrequency.Monthly && _lastDay,
            RepeatUntil: repeats && _ends == "date" ? DateOnly.FromDateTime(_until) : null,
            RepeatCount: repeats && _ends == "count" ? _count : null,
            LabelIds: _direction == TransactionKind.SelfTransfer ? [] : _labelIds);

        _busy = true;
        try
        {
            var previous = _editingId is { } editing && _open.FirstOrDefault(p => p.Id == editing) is { } before
                ? PlanDraft.From(before)
                : null;

            var result = _editingId is { } id ? await Planner.UpdateAsync(id, draft) : await Planner.CreateAsync(draft);
            if (!result.Succeeded)
            {
                Ele.Problem(result.Error!);
                return;
            }

            var plan = result.Plan!;
            if (previous is null)
            {
                Undo.Push(
                    UndoHistory.Plans,
                    $"planning {plan.Title}",
                    () => Planner.DeleteAsync(plan.Id),
                    () => Planner.RestoreAsync(plan.Id));
                Ele.Say($"Planned {plan.Title}.");

                // Its reminder is a notification, which Android 13 and later must allow first.
                // Asked here, when there is a reason to, and only once by the system.
                if (Access.IsSupported)
                {
                    await Access.RequestPromptsAsync();
                }
            }
            else
            {
                Undo.Push(
                    UndoHistory.Plans,
                    $"changes to {plan.Title}",
                    async () => Checked(await Planner.UpdateAsync(plan.Id, previous)),
                    async () => Checked(await Planner.UpdateAsync(plan.Id, draft)));
                Ele.Say($"{plan.Title} updated.");
            }

            _editing = false;
            await ReloadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DeleteAsync(Guid id)
    {
        var title = _title;
        await Planner.DeleteAsync(id);
        _editing = false;

        Undo.Push(
            UndoHistory.Plans,
            $"deleting {title}",
            () => Planner.RestoreAsync(id),
            () => Planner.DeleteAsync(id));

        Ele.Say("Plan deleted.", EleTone.Calm);
        await ReloadAsync();
    }

    private async Task SkipAsync(Plan plan)
    {
        _ticking = null;
        _editing = false;

        var result = await Planner.SkipAsync(plan.Id);
        if (!result.Succeeded)
        {
            Ele.Problem(result.Error!);
            return;
        }

        var id = plan.Id;
        Undo.Push(
            UndoHistory.Plans,
            $"skipping {plan.Title}",
            async () => Checked(await Planner.ReopenAsync(id)),
            async () => Checked(await Planner.SkipAsync(id)));

        Ele.Say(plan.Repeat.Repeats ? $"Skipped this {plan.Title}. The next one is on the list." : $"Skipped {plan.Title}.", EleTone.Calm);
        await ReloadAsync();
    }

    // Ticking off: one obvious transaction is linked at once. Anything else asks.
    private async Task TickAsync(Plan plan)
    {
        if (plan.AmountMinor is null)
        {
            await LinkAsync(plan, null);
            return;
        }

        var candidates = await Planner.CandidatesAsync(plan.Id);
        if (candidates.Count == 1)
        {
            await LinkAsync(plan, candidates[0].Id);
            return;
        }

        _candidates = candidates;
        _ticking = plan;
    }

    private async Task LinkAsync(Plan plan, Guid? transactionId)
    {
        _ticking = null;
        var result = await Planner.CompleteAsync(plan.Id, transactionId);
        if (!result.Succeeded)
        {
            Ele.Problem(result.Error!);
            return;
        }

        var id = plan.Id;
        Undo.Push(
            UndoHistory.Plans,
            $"ticking off {plan.Title}",
            async () => Checked(await Planner.ReopenAsync(id)),
            async () => Checked(await Planner.CompleteAsync(id, transactionId)));

        Ele.Say(transactionId is null ? $"{plan.Title} done." : $"{plan.Title} done, linked to its transaction.");
        await ReloadAsync();
    }

    private async Task ReopenAsync(Plan plan)
    {
        var (id, transactionId, skipped) = (plan.Id, plan.TransactionId, plan.IsSkipped);
        Checked(await Planner.ReopenAsync(id));

        Undo.Push(
            UndoHistory.Plans,
            $"reopening {plan.Title}",
            async () => Checked(skipped ? await Planner.SkipAsync(id) : await Planner.CompleteAsync(id, transactionId)),
            async () => Checked(await Planner.ReopenAsync(id)));

        Ele.Say($"{plan.Title} is back on the list.", EleTone.Calm);
        await ReloadAsync();
    }

    private static void Checked(PlanResult result)
    {
        if (!result.Succeeded)
        {
            throw new InvalidOperationException(result.Error);
        }
    }

    // The capture form, filled from the plan. Saving it ticks the plan off against the result.
    private void RecordNow(Plan plan)
    {
        _ticking = null;

        var query = new List<string> { $"plan={plan.Id}" };
        if (plan.AmountMinor is { } minor)
        {
            query.Add("amount=" + Uri.EscapeDataString(MoneyText.ToBareDecimal(Money.FromMinor(minor, Currency.Of(plan.CurrencyCode)))));
        }

        if (plan.ContainerId is { } container)
        {
            query.Add($"container={container}");
        }

        query.Add("kind=" + plan.Direction switch
        {
            TransactionKind.Credit => "credit",
            TransactionKind.SelfTransfer => "transfer",
            _ => "debit",
        });

        if (plan.DestinationContainerId is { } to)
        {
            query.Add($"to={to}");
        }

        if (!string.IsNullOrWhiteSpace(plan.CounterpartyName))
        {
            query.Add("party=" + Uri.EscapeDataString(plan.CounterpartyName));
        }

        if (plan.Labels.Count > 0)
        {
            query.Add("labels=" + string.Join(',', plan.Labels.Select(l => l.LabelId)));
        }

        query.Add("note=" + Uri.EscapeDataString(plan.Note ?? plan.Title));
        Nav.NavigateTo("capture?" + string.Join('&', query));
    }

    // The capture form's words, so a plan reads like the transaction it will become.
    private string ContainerLabel => _direction switch
    {
        TransactionKind.Credit => "Received into",
        TransactionKind.SelfTransfer => "Source container",
        _ => "Paid from",
    };
}