@using EleFi.Application.Abstractions
@using EleFi.Application.Goals
@using EleFi.Domain.Containers
@using EleFi.Domain.Goals
@using EleFi.Domain.Money
@using EleFi.Ui.Services
@inject GoalService Goals
@inject IContainerRepository Containers
@inject EleReactions Ele
@inject UndoHistory Undo
@inject NavigationManager Nav
@inject IClock Clock

@*
    Goals: what the money is for.

    Each card says three things in order of use: how far along it is, whether that is on
    track for the date, and what it needs each month from here. Progress is a view over money
    already in a container, never extra money (GL3), so nothing here touches net worth.
*@

<p class="muted small goals-head">Save towards something and see whether you are on track.</p>

@foreach (var warning in _warnings)
{
    <div class="notice" role="status">@warning</div>
}

@if (_loading)
{
    <div class="card"><div class="skeleton" style="width:60%;"></div></div>
}
else if (_views.Count == 0)
{
    <div class="card empty-state">
        <svg class="empty-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
            <circle cx="12" cy="12" r="8.5" /><circle cx="12" cy="12" r="5" /><circle cx="12" cy="12" r="1.5" />
        </svg>
        <div class="who">No goals yet</div>
        <p class="muted small">
            A trip, a ring, a rainy-day fund. Follow a container set aside for it, or count what
            you put in from money that is mixed with everything else.
        </p>
    </div>
}
else
{
    @foreach (var view in _views.Where(v => !v.Goal.IsArchived))
    {
        @GoalCard(view)
    }

    @if (_views.Any(v => v.Goal.IsArchived))
    {
        <details class="completed">
            <summary>Archived (@_views.Count(v => v.Goal.IsArchived))</summary>
            @foreach (var view in _views.Where(v => v.Goal.IsArchived))
            {
                @GoalCard(view)
            }
        </details>
    }
}

<Modal Open="_editing" Title="@(_editingId is null ? "New goal" : "Edit goal")" OnCancel="() => _editing = false">
    <div class="field">
        <label for="goal-name">What is it for?</label>
        <input id="goal-name" type="text" @bind="_name" placeholder="Engagement ring" maxlength="120" autocomplete="off" />
    </div>

    <div class="field">
        <label for="goal-target">Target</label>
        <input id="goal-target" class="amount-input" type="text" inputmode="decimal" @bind="_targetText" placeholder="0.00" autocomplete="off" />
    </div>

    <div class="field">
        <label for="goal-date">By</label>
        <input id="goal-date" type="date" @bind="_targetDate" />
    </div>

    <div class="field">
        <label>How should progress be measured?</label>
        <div class="mode-cards" role="radiogroup" aria-label="How progress is measured">
            <button type="button" role="radio" aria-checked="@(_mode == FundingMode.TracksContainerBalance ? "true" : "false")"
                    class="mode-card @(_mode == FundingMode.TracksContainerBalance ? "on" : null)" id="mode-balance"
                    @onclick="() => _mode = FundingMode.TracksContainerBalance">
                <span class="who">Follow a container</span>
                <span class="meta">Its balance is the progress. For money set aside only for this, like an RD.</span>
            </button>
            <button type="button" role="radio" aria-checked="@(_mode == FundingMode.TracksContributions ? "true" : "false")"
                    class="mode-card @(_mode == FundingMode.TracksContributions ? "on" : null)" id="mode-contributions"
                    @onclick="() => _mode = FundingMode.TracksContributions">
                <span class="who">Count what I put in</span>
                <span class="meta">Add transactions to it. For money that sits with everything else.</span>
            </button>
        </div>
    </div>

    <div class="field">
        <label>@(_mode == FundingMode.TracksContainerBalance ? "Which containers?" : "Where the money sits (optional)")</label>
        @if (_mode == FundingMode.TracksContributions)
        {
            <p class="muted small" style="margin:0 0 6px;">For a warning if goals claim more than it holds.</p>
        }
        <div class="goal-pick-list" id="goal-containers" role="group" aria-label="Containers">
            @foreach (var container in _containers)
            {
                var on = _picked.Contains(container.Id);
                <button type="button" role="checkbox" class="goal-pick @(on ? "on" : null)"
                        aria-checked="@(on ? "true" : "false")" @onclick="() => Toggle(container.Id)">
                    <span class="goal-check" aria-hidden="true">@(on ? "✓" : "")</span>
                    <span class="goal-pick-name">@container.Name</span>
                </button>
            }
        </div>
    </div>

    @if (_mode == FundingMode.TracksContributions)
    {
        <div class="field">
            <label for="goal-opening">Already saved <span class="muted small">(optional)</span></label>
            <input id="goal-opening" class="amount-input" type="text" inputmode="decimal" @bind="_openingText" placeholder="0.00" autocomplete="off" />
        </div>
    }

    <div class="field">
        <label for="goal-monthly">I plan to put aside each month <span class="muted small">(optional)</span></label>
        <input id="goal-monthly" class="amount-input" type="text" inputmode="decimal" @bind="_monthlyText" placeholder="0.00" autocomplete="off" />
    </div>

    <button class="primary btn-block" @onclick="SaveAsync">Save</button>

    @if (_editingId is { } id)
    {
        <div class="row" style="margin-top:10px;">
            <button class="btn-ghost grow" @onclick="() => ArchiveAsync(id)">@(_editingArchived ? "Bring back" : "Archive")</button>
            <button class="btn-ghost danger grow" @onclick="() => DeleteAsync(id)">Delete</button>
        </div>
    }
</Modal>

@code {
    private IReadOnlyList<GoalView> _views = [];
    private IReadOnlyList<string> _warnings = [];
    private IReadOnlyList<Container> _containers = [];
    private bool _loading = true;

    private bool _editing;
    private Guid? _editingId;
    private bool _editingArchived;
    private string _name = string.Empty;
    private string _targetText = string.Empty;
    private DateOnly _targetDate;
    private FundingMode _mode = FundingMode.TracksContributions;
    private HashSet<Guid> _picked = [];
    private string _openingText = string.Empty;
    private string _monthlyText = string.Empty;

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        _containers = await Containers.ListSelectableAsync();
        await LoadAsync();
    }

    /// <summary>Loads the goals again. Called by the page's undo arrows.</summary>
    public async Task ReloadAsync()
    {
        await LoadAsync();
        StateHasChanged();
    }

    private async Task LoadAsync()
    {
        _views = await Goals.OverviewAsync();
        _warnings = await Goals.WarningsAsync();
        _loading = false;
    }

    private RenderFragment GoalCard(GoalView view) => __builder =>
    {
        var goal = view.Goal;
        var standing = view.Standing;
        var currency = Currency.Of(goal.CurrencyCode);
        var expectedPercent = goal.TargetAmountMinor <= 0 ? 0 : (int)Math.Clamp(standing.ExpectedMinor * 100 / goal.TargetAmountMinor, 0, 100);

        <div class="card goal-card" @key="goal.Id">
            <button type="button" class="goal-body" aria-label="Edit @goal.Name" @onclick="() => StartEdit(goal)">
                <span class="row between">
                    <span class="who">@goal.Name</span>
                    <span class="goal-status @StatusClass(standing.Status)">@StatusText(standing.Status)</span>
                </span>
                <span class="goal-bar" role="progressbar" aria-label="@goal.Name progress"
                      aria-valuemin="0" aria-valuemax="100" aria-valuenow="@standing.Percent">
                    <span class="goal-fill @StatusClass(standing.Status)" style="width:@(standing.Percent)%;"></span>
                    @if (standing.Status != GoalStatus.Achieved)
                    {
                        <span class="goal-expected" style="left:@(expectedPercent)%;" title="Where it should be today"></span>
                    }
                </span>
                <span class="row between meta">
                    <span><span class="amount">@MoneyText.ToDisplayString(Money.SignedMinor(standing.ProgressMinor, currency))</span> of <span class="amount">@MoneyText.ToDisplayString(Money.FromMinor(goal.TargetAmountMinor, currency))</span></span>
                    <span>@standing.Percent%</span>
                </span>
                <span class="meta">
                    @if (standing.Status == GoalStatus.Achieved)
                    {
                        @:Reached. Well done.
                    }
                    else
                    {
                        <span class="amount">@MoneyText.ToDisplayString(Money.FromMinor(standing.RequiredMonthlyMinor, currency))</span>@($" a month to reach it by {goal.TargetDate:MMM yyyy}.")
                        @if (goal.MonthlyContributionMinor is { } monthly && monthly > 0)
                        {
                            @($" You planned ")<span class="amount">@MoneyText.ToDisplayString(Money.FromMinor(monthly, currency))</span>@(".")
                        }
                    }
                </span>
                @if (Projection(view, currency) is { } projection)
                {
                    <span class="meta goal-projection">@projection</span>
                }
                <span class="meta">@Describe(view)</span>
            </button>
            @if (goal.FundingMode == FundingMode.TracksContributions && !goal.IsArchived)
            {
                <button type="button" class="btn-ghost btn-block goal-add" @onclick="() => AddMoney(goal)">Add money to it</button>
            }
        </div>
    };

    private static string Describe(GoalView view) => view.Goal.FundingMode == FundingMode.TracksContainerBalance
        ? $"Follows {string.Join(", ", view.ContainerNames)}"
        : view.ContainerNames.Count == 0
            ? "Counts what you put in"
            : $"Counts what you put in, kept in {string.Join(", ", view.ContainerNames)}";

    private static string StatusText(GoalStatus status) => status switch
    {
        GoalStatus.Achieved => "Achieved",
        GoalStatus.OnTrack => "On track",
        _ => "Behind",
    };

    private static string StatusClass(GoalStatus status) => status switch
    {
        GoalStatus.Achieved => "achieved",
        GoalStatus.OnTrack => "on-track",
        _ => "behind",
    };

    /// <summary>Opens the sheet for a new goal. Called by the page's New goal button.</summary>
    public void StartCreate()
    {
        _editingId = null;
        _editingArchived = false;
        _name = string.Empty;
        _targetText = string.Empty;
        _targetDate = Clock.Today.AddYears(1);
        _mode = FundingMode.TracksContributions;
        _picked = [];
        _openingText = string.Empty;
        _monthlyText = string.Empty;
        _editing = true;
        StateHasChanged();
    }

    private void StartEdit(Goal goal)
    {
        var currency = Currency.Of(goal.CurrencyCode);
        _editingId = goal.Id;
        _editingArchived = goal.IsArchived;
        _name = goal.Name;
        _targetText = MoneyText.ToBareDecimal(Money.FromMinor(goal.TargetAmountMinor, currency));
        _targetDate = goal.TargetDate;
        _mode = goal.FundingMode;
        _picked = [.. goal.Containers.Select(c => c.ContainerId)];
        _openingText = goal.OpeningAllocationMinor > 0 ? MoneyText.ToBareDecimal(Money.FromMinor(goal.OpeningAllocationMinor, currency)) : string.Empty;
        _monthlyText = goal.MonthlyContributionMinor is { } monthly ? MoneyText.ToBareDecimal(Money.FromMinor(monthly, currency)) : string.Empty;
        _editing = true;
    }

    private void Toggle(Guid containerId)
    {
        if (!_picked.Remove(containerId))
        {
            _picked.Add(containerId);
        }
    }

    private async Task SaveAsync()
    {
        if (!MoneyText.TryParse(_targetText, Currency.Inr, out var target))
        {
            Ele.Problem("Enter the target as an amount, like 300000.");
            return;
        }

        long opening = 0;
        if (_mode == FundingMode.TracksContributions && !string.IsNullOrWhiteSpace(_openingText))
        {
            if (!MoneyText.TryParse(_openingText, Currency.Inr, out var openingMoney))
            {
                Ele.Problem("Enter what is already saved as an amount.");
                return;
            }

            opening = openingMoney.Minor;
        }

        long? monthly = null;
        if (!string.IsNullOrWhiteSpace(_monthlyText))
        {
            if (!MoneyText.TryParse(_monthlyText, Currency.Inr, out var monthlyMoney))
            {
                Ele.Problem("Enter the monthly amount as an amount.");
                return;
            }

            monthly = monthlyMoney.Minor;
        }

        var draft = new GoalDraft(_name, target.Minor, _targetDate, _mode, [.. _picked], opening, monthly);
        var before = _editingId is { } editing ? _views.FirstOrDefault(v => v.Goal.Id == editing)?.Goal : null;
        var previous = before is null ? null : GoalDraft.From(before);

        var result = _editingId is { } id ? await Goals.UpdateAsync(id, draft) : await Goals.CreateAsync(draft);
        if (!result.Succeeded)
        {
            Ele.Problem(result.Error!);
            return;
        }

        var goal = result.Goal!;
        if (previous is null)
        {
            Undo.Push(
                UndoHistory.Goals,
                $"adding {goal.Name}",
                () => Goals.DeleteAsync(goal.Id),
                () => Goals.RestoreAsync(goal.Id, []));
            Ele.Say($"{goal.Name} added. Good luck with it.");
        }
        else
        {
            Undo.Push(
                UndoHistory.Goals,
                $"changes to {goal.Name}",
                async () => Checked(await Goals.UpdateAsync(goal.Id, previous)),
                async () => Checked(await Goals.UpdateAsync(goal.Id, draft)));
            Ele.Say($"{goal.Name} updated.");
        }

        _editing = false;
        await LoadAsync();
    }

    private async Task ArchiveAsync(Guid id)
    {
        var archive = !_editingArchived;
        await Goals.ArchiveAsync(id, archive);
        _editing = false;
        Undo.Push(
            UndoHistory.Goals,
            archive ? "archiving the goal" : "bringing the goal back",
            () => Goals.ArchiveAsync(id, !archive),
            () => Goals.ArchiveAsync(id, archive));
        Ele.Say(archive ? "Archived. Its transactions are kept." : "Back among your goals.", EleTone.Calm);
        await LoadAsync();
    }

    private async Task DeleteAsync(Guid id)
    {
        var name = _name;
        var contributions = await Goals.DeleteAsync(id);
        _editing = false;

        // Undo brings it back with the same transactions counted toward it.
        Undo.Push(
            UndoHistory.Goals,
            $"deleting {name}",
            () => Goals.RestoreAsync(id, contributions),
            () => Goals.DeleteAsync(id));
        Ele.Say("Goal deleted. Its transactions are untouched.", EleTone.Calm);
        await LoadAsync();
    }

    private static void Checked(GoalResult result)
    {
        if (!result.Succeeded)
        {
            throw new InvalidOperationException(result.Error);
        }
    }

    private static string? Projection(GoalView view, Currency currency)
    {
        if (view.ProjectedFinish is not { } finish || view.Standing.Status == GoalStatus.Achieved)
        {
            return null;
        }

        var pace = MoneyText.ToDisplayString(Money.FromMinor(view.PaceMinor, currency));
        return view.PaceIsPlanned
            ? $"At your planned {pace} a month, done by {finish:d MMM yyyy}."
            : $"At this pace ({pace} a month), done by {finish:d MMM yyyy}.";
    }

    // Money put toward a goal is real money moving, so it is recorded as a transaction and
    // attributed to the goal, rather than typed into the goal as a number.
    private void AddMoney(Goal goal)
    {
        var query = $"capture?goal={goal.Id}&kind=transfer&note={Uri.EscapeDataString(goal.Name)}";
        if (goal.Containers.FirstOrDefault() is { } kept)
        {
            query += $"&to={kept.ContainerId}";
        }

        Nav.NavigateTo(query);
    }
}
