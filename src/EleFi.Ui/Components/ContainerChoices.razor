@using EleFi.Domain.Containers

@*
    Containers as tappable chips, in the same order as ContainerSelect.

    For quick capture, where one tap should both choose and move on. No section headings:
    the order (cards, banks, the rest) says it, and a small gap marks where one kind ends.
    Each chip carries the bank and last four digits under the name.
*@

<div class="container-choices chips">
    @for (var i = 0; i < _ordered.Count; i++)
    {
        var container = _ordered[i];
        var on = container.Id == Selected;
        var startsSection = i > 0 && container.Kind.PickerGroup() != _ordered[i - 1].Kind.PickerGroup();
        @if (startsSection)
        {
            <span class="choice-break" aria-hidden="true"></span>
        }
        <button type="button"
                class="chip chip-stacked @(on ? "on" : string.Empty)"
                aria-pressed="@(on ? "true" : "false")"
                @onclick="() => OnChosen.InvokeAsync(container.Id)">
            <span>@container.Name</span>
            @if (container.Describe() is { } detail)
            {
                <small class="detail">@detail</small>
            }
        </button>
    }
</div>

@code {
    private IReadOnlyList<Container> _ordered = [];
    private IReadOnlyList<Container>? _orderedFrom;

    /// <summary>The containers to choose from, in the user's preferred order.</summary>
    [Parameter]
    public IReadOnlyList<Container> Containers { get; set; } = [];

    /// <summary>The container currently chosen.</summary>
    [Parameter]
    public Guid Selected { get; set; }

    /// <summary>Raised when a chip is tapped.</summary>
    [Parameter]
    public EventCallback<Guid> OnChosen { get; set; }

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(_orderedFrom, Containers))
        {
            _orderedFrom = Containers;
            _ordered = ContainerGrouping.InPickerOrder(Containers);
        }
    }
}
