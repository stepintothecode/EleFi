@using EleFi.Application.Typeahead

@*
    A text field with its likely answers drawn above it.

    Replaces <datalist>. On Android the browser draws a datalist as its own popup over the
    keyboard and down the whole screen, and it filtered only the twenty names it had been
    handed. This draws the answers inside the page, above the field, where the keyboard
    cannot cover them, and searches every name the user has ever entered.

    The panel shows in two cases only. With the field empty, the few most used (where the
    caller asks for them). While the user is typing, the best matches from the whole history.
    It never repeats what is already in the field: a value that was picked, or that the form
    started with, is shown once, in the field, and nowhere else.
*@

<div class="typeahead">
    @if (ShowPanel)
    {
        <div class="typeahead-panel" role="listbox" aria-label="@PanelLabel">
            <div class="typeahead-caption">@(HasQuery ? "Matches" : "Most used")</div>

            @if (_shown.Count == 0)
            {
                @* Said rather than left blank, so an empty panel reads as "this is new" and
                   not as "the app has forgotten everyone". *@
                <div class="typeahead-empty">No match. &ldquo;@Value.Trim()&rdquo; will be added as new.</div>
            }
            else
            {
                <div class="typeahead-options">
                    @foreach (var name in _shown)
                    {
                        <button type="button" role="option" class="chip" aria-selected="false"
                                @onclick="() => PickAsync(name)">@name</button>
                    }
                </div>
            }
        </div>
    }

    <input id="@Id"
           value="@Value"
           placeholder="@Placeholder"
           autocomplete="off"
           autocapitalize="words"
           enterkeyhint="@EnterKeyHint"
           @oninput="OnInputAsync"
           @onkeydown="OnKeyDown" />
</div>

@code {
    private IReadOnlyList<string> _shown = [];
    private bool _exactMatch;
    private IReadOnlyList<TypeaheadCandidate>? _rankedFrom;
    private string? _rankedFor;

    // True only while the text in the field is what the user is typing. A pick, or a value
    // handed in by the form, ends it, so neither is echoed back as a "match".
    private bool _typing;
    private string? _lastEmitted;

    /// <summary>The input's id, so a label can point at it.</summary>
    [Parameter]
    public string? Id { get; set; }

    /// <summary>The current text.</summary>
    [Parameter]
    public string Value { get; set; } = string.Empty;

    /// <summary>Raised on every keystroke and on every pick.</summary>
    [Parameter]
    public EventCallback<string> ValueChanged { get; set; }

    /// <summary>Raised when an answer is tapped, after <see cref="ValueChanged"/>.</summary>
    [Parameter]
    public EventCallback<string> OnPicked { get; set; }

    /// <summary>Raised for key presses in the field, such as Enter.</summary>
    [Parameter]
    public EventCallback<KeyboardEventArgs> OnKeyDown { get; set; }

    /// <summary>Everything that could be offered. The whole history, not a recent slice.</summary>
    [Parameter]
    public IReadOnlyList<TypeaheadCandidate> Candidates { get; set; } = [];

    /// <summary>How many to show while the field is empty. Zero shows nothing until typing starts.</summary>
    [Parameter]
    public int IdleCount { get; set; } = 3;

    /// <summary>How many matches to show while typing.</summary>
    [Parameter]
    public int MatchCount { get; set; } = 5;

    /// <summary>Placeholder text in the empty field.</summary>
    [Parameter]
    public string? Placeholder { get; set; }

    /// <summary>What the keyboard's action key says.</summary>
    [Parameter]
    public string EnterKeyHint { get; set; } = "next";

    /// <summary>The accessible name of the answer list.</summary>
    [Parameter]
    public string PanelLabel { get; set; } = "Suggestions";

    private bool HasQuery => !string.IsNullOrWhiteSpace(Value);

    // Empty: the most used, if asked for. Typing: matches, or "will be added as new", unless
    // what is typed already is exactly an existing name and there is nothing else to offer.
    private bool ShowPanel =>
        HasQuery
            ? _typing && (_shown.Count > 0 || !_exactMatch)
            : IdleCount > 0 && _shown.Count > 0;

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        // A value that did not come from this field (the form loading a transaction, or
        // clearing after a save) is not something the user is typing.
        if (!string.Equals(Value, _lastEmitted, StringComparison.Ordinal))
        {
            _typing = false;
            _lastEmitted = Value;
        }

        Rerank();
    }

    // Ranked only when the text or the candidate list actually changed, so an unrelated
    // re-render elsewhere on the form costs nothing here.
    private void Rerank()
    {
        if (ReferenceEquals(_rankedFrom, Candidates) && string.Equals(_rankedFor, Value, StringComparison.Ordinal))
        {
            return;
        }

        _rankedFrom = Candidates;
        _rankedFor = Value;

        if (!HasQuery)
        {
            _shown = TypeaheadRanker.Rank(Candidates, null, IdleCount);
            _exactMatch = false;
            return;
        }

        // One extra, so leaving out the exact match still leaves a full panel.
        var ranked = TypeaheadRanker.Rank(Candidates, Value, MatchCount + 1);
        var typed = Value.Trim();

        _exactMatch = ranked.Any(n => string.Equals(n, typed, StringComparison.OrdinalIgnoreCase));
        _shown = ranked
            .Where(n => !string.Equals(n, typed, StringComparison.OrdinalIgnoreCase))
            .Take(MatchCount)
            .ToList();
    }

    private async Task OnInputAsync(ChangeEventArgs e)
    {
        Value = e.Value?.ToString() ?? string.Empty;
        _typing = true;
        _lastEmitted = Value;
        Rerank();
        await ValueChanged.InvokeAsync(Value);
    }

    private async Task PickAsync(string name)
    {
        Value = name;
        _typing = false;
        _lastEmitted = name;
        Rerank();
        await ValueChanged.InvokeAsync(name);
        await OnPicked.InvokeAsync(name);
    }
}
