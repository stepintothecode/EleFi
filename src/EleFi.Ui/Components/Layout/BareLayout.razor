@inherits LayoutComponentBase
@using EleFi.Ui.Services
@inject PrivacyMode Privacy

@*
    A layout with no tab bar, for screens launched from outside the app.

    Quick capture opens from a widget or a Quick Settings tile with one job to do. Showing
    the full navigation there invites a detour, and the whole point of that screen is that
    it takes three taps and gets out of the way. Hidden amounts stay hidden here too.
*@

<div class="shell @Privacy.CssClass">
    <main class="page page-bare">
        @Body
    </main>
</div>
