@inherits LayoutComponentBase
@using EleFi.Ui.Services
@implements IDisposable
@inject PrivacyMode Privacy
@inject EleGuide Guide

@*
    The error boundary is not decoration.

    Without it, one component throwing takes down the whole Blazor circuit and the user gets
    a red bar over a blank screen with no way back. With it, the failure is contained to the
    page, the tabs still work, and the message says the thing that actually matters: the
    data on the device is untouched.

    The shell carries the privacy class, so hiding amounts covers every page, every sheet and
    every word Ele says without any of them knowing the switch exists.

    While Ele's guide is open the shell also says so, and which tab the step is about, so the
    tab bar can light that one tab above the dimmed page without any tab knowing the guide.
*@

<div class="shell @Privacy.CssClass @GuideClass">
    <main class="page">
        <ErrorBoundary @ref="_boundary">
            <ChildContent>
                @Body
            </ChildContent>
            <ErrorContent Context="error">
                <h1>This screen did not load</h1>
                <div class="notice error" role="alert">
                    @error.Message
                </div>
                <p class="muted small">
                    Nothing was written and nothing was lost. Your ledger is on this device and is
                    unaffected by a screen failing to draw.
                </p>
                <button class="primary btn-block" @onclick="Recover">Try again</button>
            </ErrorContent>
        </ErrorBoundary>
    </main>

    <NavMenu />
    <EleOverlay />
    <EleGuideOverlay />
</div>

@code {
    private ErrorBoundary? _boundary;

    private string? GuideClass => Guide.IsOpen
        ? $"guiding spot-{Guide.Current.Spot.ToString().ToLowerInvariant()}"
        : null;

    protected override void OnInitialized()
    {
        Privacy.Changed += OnShellChanged;
        Guide.Changed += OnShellChanged;
    }

    // A boundary latches once it has caught something. Without this, navigating away and
    // back shows the same error over a page that would now render perfectly well.
    protected override void OnParametersSet() => _boundary?.Recover();

    public void Dispose()
    {
        Privacy.Changed -= OnShellChanged;
        Guide.Changed -= OnShellChanged;
    }

    private void OnShellChanged() => InvokeAsync(StateHasChanged);

    private void Recover() => _boundary?.Recover();
}
