@using EleFi.Domain.Containers

@*
    A container picker: the chosen container as a button, and a sheet to choose another.

    Not a native <select>. Android draws a select's options as one line of plain text, so the
    bank and last four digits could only be tacked on after the name, and the section
    headings repeated what the order already says. This draws each container as its name with
    the bank and last four in small text underneath, in picker order (cards, banks, the rest),
    with a hairline between sections instead of a heading.
*@

<button type="button" id="@Id" class="picker" aria-haspopup="dialog" aria-label="@AriaLabel"
        @onclick="() => _open = true">
    @if (_selected is { } chosen)
    {
        <span class="picker-text">
            <span class="picker-name">@chosen.Name</span>
            @if (chosen.Describe() is { } detail)
            {
                <span class="detail">@detail</span>
            }
        </span>
    }
    else
    {
        <span class="picker-text muted">@(Placeholder ?? "Choose one")</span>
    }
    <svg class="picker-chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
         stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M6 9l6 6 6-6" />
    </svg>
</button>

<Modal Open="_open" Title="@Title" OnCancel="() => _open = false">
    <div class="picker-list" role="listbox" aria-label="@Title">
        @for (var i = 0; i < _ordered.Count; i++)
        {
            var container = _ordered[i];
            var on = container.Id == Value;
            var startsSection = i > 0 && container.Kind.PickerGroup() != _ordered[i - 1].Kind.PickerGroup();
            <button type="button" role="option"
                    class="picker-option @(on ? "on" : null) @(startsSection ? "section-start" : null)"
                    aria-selected="@(on ? "true" : "false")"
                    @onclick="() => ChooseAsync(container.Id)">
                <span class="picker-text">
                    <span class="picker-name">@container.Name</span>
                    @if (container.Describe() is { } detail)
                    {
                        <span class="detail">@detail</span>
                    }
                </span>
                @if (on)
                {
                    <svg class="picker-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"
                         stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M5 12.5l4.5 4.5L19 7.5" />
                    </svg>
                }
            </button>
        }
    </div>
</Modal>

@code {
    private IReadOnlyList<Container> _ordered = [];
    private IReadOnlyList<Container>? _orderedFrom;
    private Container? _selected;
    private bool _open;

    /// <summary>The button's id, so a label can point at it.</summary>
    [Parameter]
    public string? Id { get; set; }

    /// <summary>An accessible name, for when there is no visible label.</summary>
    [Parameter]
    public string? AriaLabel { get; set; }

    /// <summary>The sheet's title: what is being chosen, such as "Paid from".</summary>
    [Parameter]
    public string Title { get; set; } = "Choose a container";

    /// <summary>The containers to choose from, in the user's preferred order.</summary>
    [Parameter]
    public IReadOnlyList<Container> Containers { get; set; } = [];

    /// <summary>The chosen container, or empty for none yet.</summary>
    [Parameter]
    public Guid Value { get; set; }

    /// <summary>
    /// What the button says while nothing is chosen, such as "Choose one". Shown instead of
    /// silently defaulting, so an unknown container is asked for rather than guessed.
    /// </summary>
    [Parameter]
    public string? Placeholder { get; set; }

    /// <summary>Raised when a different container is chosen.</summary>
    [Parameter]
    public EventCallback<Guid> ValueChanged { get; set; }

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(_orderedFrom, Containers))
        {
            _orderedFrom = Containers;
            _ordered = ContainerGrouping.InPickerOrder(Containers);
        }

        _selected = _ordered.FirstOrDefault(c => c.Id == Value);
    }

    private async Task ChooseAsync(Guid id)
    {
        _open = false;
        _selected = _ordered.FirstOrDefault(c => c.Id == id);

        if (id != Value)
        {
            await ValueChanged.InvokeAsync(id);
        }
    }
}
